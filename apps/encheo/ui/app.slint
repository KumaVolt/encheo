import { AboutSlint, ListView } from "std-widgets.slint";

// Encheo UI. One window, four screens: sign-in, home (with library pages and search), details,
// player. Rust fills the models; this file only lays things out and forwards input.
//
// The look follows macOS conventions: translucent sidebar under the window buttons, rounded
// selection rows, large rounded artwork, system-style dark palette.

export struct Poster {
    id: string,
    title: string,
    subtitle: string,
    art-url: string,
    image: image,
    progress: float,   // 0..1, 0 = not started
    watched: bool,
    square: bool,      // album and artist art
}

/// The big title at the top of Home.
export struct Billboard {
    id: string,        // empty: no billboard
    title: string,
    meta: string,      // "2024 · Drama, Mystery · 1 hr 57 min"
    summary: string,
    art-url: string,
    image: image,
    logo-url: string,  // the title as artwork, when the server has it
    logo: image,
    play-label: string,
}

export struct HomeRow {
    title: string,
    library: int,      // sidebar index for "See All", -1 for none
    landscape: bool,
    square: bool,
    items: [Poster],
}

export struct Person {
    name: string,
    role: string,
    art-url: string,
    image: image,
}

export struct FoundSource {
    kind: int,         // as in the Add Source form: 1 SMB, 2 WebDAV, 3 Jellyfin/Emby
    label: string,     // "Jellyfin", "SMB", …
    name: string,
    address: string,
}

export struct SourceRow {
    kind: string,      // "plex", "server" (Jellyfin/Emby), "files" or "seerr"
    index: int,        // place in its own list
    title: string,
    label: string,     // "Plex", "Jellyfin", "SMB", …
    detail: string,    // address, user
    signed-in: bool,   // Plex: false offers Sign In instead of Sign Out
}

export struct Score {
    source: string,    // "IMDb", "Critics", "Audience", "TMDB"
    value: string,     // "6.7", "94%"
    tint: color,
}

export struct Track {
    id: string,
    number: string,
    title: string,
    artist: string,
    runtime: string,
    playing: bool,
}

export struct LibraryEntry {
    key: string,
    title: string,
    kind: string,      // movie, show, artist, folder
    group: string,     // server or "Sources"; shown as a heading
}

export struct Episode {
    id: string,
    title: string,
    label: string,
    summary: string,
    art-url: string,
    image: image,
    progress: float,
    watched: bool,
    runtime: string,
}

// A line of a song's words. `time`: seconds into the song (synced lyrics only).
export struct LyricLine {
    text: string,
    time: float,
}

export struct TrackOption {
    id: int,           // mpv track id; -1 = off
    label: string,
    selected: bool,
}

// A person in the Plex Home ("Who's watching?").
export struct ProfileEntry {
    name: string,
    initial: string,   // shown while the picture loads, or when there's none
    art-url: string,
    locked: bool,      // asks for a PIN
    current: bool,     // the profile in use
}

// Movie and TV libraries: a chip in the bar above the grid (Sort, Genre, …).
export struct FilterChip {
    text: string,
    active: bool,      // narrows the library down
    menu: bool,        // opens a list of choices (Clear doesn't)
}

// A letter on the A–Z rail and the first title it jumps to.
export struct AzLetter {
    label: string,
    index: int,        // grid index (of the next letter's titles when this one has none)
    present: bool,     // titles start with it
}

export struct ListEntry {
    id: string,
    title: string,
    detail: string,
    current: bool,
}

/// Everything the video player shows and does. A global, so Rust and every part of the player
/// UI share it without threading properties through the window.
export global PlayerState {
    in-out property <string> title;
    in-out property <string> subtitle;
    in-out property <float> position;      // seconds
    in-out property <float> duration;      // seconds
    in-out property <string> position-text;
    in-out property <string> remaining-text;
    in-out property <bool> paused;
    in-out property <bool> buffering;
    in-out property <bool> controls-visible: true;
    in-out property <string> skip-label;
    in-out property <float> volume: 1.0;   // 0..1
    in-out property <bool> muted;
    in-out property <bool> has-prev;
    in-out property <bool> has-next;
    in-out property <bool> fullscreen;
    in-out property <bool> pip;
    // Desktop only: Picture in Picture and fullscreen buttons.
    in-out property <bool> window-modes: true;
    in-out property <string> panel;        // "", "settings", "list"
    in-out property <[TrackOption]> audio-tracks;
    in-out property <[TrackOption]> sub-tracks;
    in-out property <bool> sub-off;
    in-out property <float> speed: 1.0;
    in-out property <float> sub-scale: 1.0;     // subtitle size
    in-out property <float> sub-delay;          // seconds, + = later
    in-out property <float> audio-delay;        // seconds, + = later
    in-out property <bool> auto-skip;           // skip intros/credits by themselves
    // TV remote in the player: 0 the timeline, 1 the buttons, 2 the Skip button.
    in-out property <int> focus-row;
    in-out property <int> focus-col: 2;
    // Remote focus inside the open panel: a row from the top, and a choice within that row.
    in-out property <int> panel-row;
    in-out property <int> panel-col;
    // The settings panel's rows: audio tracks, Off, (Find online), subtitle tracks, then these.
    out property <int> off-row: self.audio-tracks.length;
    out property <int> find-row: self.can-find-subs ? self.off-row + 1 : -1;
    out property <int> subs-row: self.off-row + (self.can-find-subs ? 2 : 1);
    out property <int> speed-row: self.subs-row + self.sub-tracks.length;
    out property <int> size-row: self.speed-row + 1;
    out property <int> sub-delay-row: self.speed-row + 2;
    out property <int> audio-delay-row: self.speed-row + 3;
    out property <int> auto-skip-row: self.speed-row + 4;
    out property <[float]> speeds: [0.5, 0.75, 1.0, 1.25, 1.5, 2.0];
    out property <[float]> sizes: [0.8, 1.0, 1.25, 1.6];
    // Android HDR: the video is on its own layer, mpv draws no subtitles; this is the line to show.
    in-out property <bool> direct;
    in-out property <string> direct-sub;
    callback set-sub-scale(float);
    callback nudge-sub-delay(float);
    callback nudge-audio-delay(float);
    callback set-auto-skip(bool);
    in-out property <string> list-title;
    in-out property <[ListEntry]> list-items;
    // Online subtitle search (Plex / Jellyfin / Emby).
    in-out property <bool> can-find-subs;
    in-out property <string> sub-search-status;
    in-out property <[ListEntry]> sub-langs;      // id = language code
    in-out property <[ListEntry]> sub-results;    // id = "sub:<key>"
    callback find-subs(string);
    callback toggle-pause();
    callback seek-to(float);
    callback scrub-to(float);              // while dragging: fast, keyframe seek
    callback seek-by(float);
    callback stop();
    callback skip-marker();
    callback poke();
    callback toggle-controls();
    callback set-volume(float);
    callback toggle-mute();
    callback prev();
    callback next();
    callback toggle-fullscreen();
    callback toggle-pip();
    callback open-panel(string);
    callback select-audio(int);
    callback select-sub(int);
    callback set-speed(float);
    callback pick(string);
}

/// Keyboard / TV-remote focus. Rust moves it (it knows how many items each row has); the UI only
/// draws the highlight and scrolls it into view. Inactive until an arrow key is pressed, so mouse
/// and touch users never see it.
export global Nav {
    in-out property <bool> active;
    in-out property <string> zone: "content";   // "side", "content", "detail", "dialog" (Settings)
    in-out property <int> row;
    in-out property <int> col;
    in-out property <int> grid-cols: 1;          // set by the library grid
    in-out property <int> search-request;        // bumped to focus the search field
    // Rows of the details page, set by Rust (-1 when absent).
    in-out property <int> d-seasons: -1;
    in-out property <int> d-episodes: -1;
    in-out property <int> d-tracks: -1;
    in-out property <int> d-albums: -1;
    in-out property <int> d-related: -1;
    // Arrow keys and Enter; returns whether the key was used.
    callback key(string) -> bool;
    // Back (Android's Back button): closes a window or leaves a page; false when there's
    // nothing to go back to, so Android can leave the app.
    callback back() -> bool;
    // Settings closed (any way): the focus goes back to where it was.
    callback dialog-closed();
    // The search field gave up focus (Down / Back / Enter on it).
    callback leave-search();
    // TV: open the search page; a key of its keyboard was pressed ("a", "1", "space", "delete", "clear").
    callback tv-search();
    callback tv-key(string);
    in-out property <int> refocus-request;    // bumped to give the window its keys back
}

export global Theme {
    // Close to macOS dark mode system colours.
    out property <color> bg: #1c1c1e;
    out property <color> sidebar: #232326c8;          // translucent over the window blur
    out property <color> separator: #ffffff14;
    out property <color> fill: #ffffff12;             // controls, search field
    out property <color> fill-hover: #ffffff1f;
    out property <color> selection: #ffffff24;
    out property <color> card: #2c2c2e;
    out property <color> text: #f5f5f7;
    out property <color> secondary: #ebebf599;
    out property <color> tertiary: #ebebf560;
    out property <color> accent: #f5a33b;
    out property <color> accent-text: #1d1203;
    out property <length> header-height: 52px;        // the titlebar strip, window buttons live here
    // macOS: the window buttons sit inside our content (transparent titlebar). Elsewhere the
    // system draws a normal title bar above us, so nothing needs to make room for them.
    in-out property <bool> buttons-in-content: true;
    out property <length> buttons-inset: buttons-in-content ? 84px : 20px;
    out property <length> sidebar-top: buttons-in-content ? header-height : 14px;
    // Android TV: seen from the sofa with a remote. The sidebar shrinks to icons and opens when
    // the remote moves into it.
    in-out property <bool> tv: false;
    out property <length> rail-width: 76px;
    // Smooth scrolling and transitions; Settings can turn them off.
    in-out property <bool> animate: true;
    // How long a remote/keyboard scroll glides.
    out property <duration> glide: animate ? 300ms : 0ms;
}

// Posters' pictures, loaded only for cards on or near the screen and let go when far away.
export global Art {
    // The picture for a web address: ready, or (empty for now) starts loading it.
    pure callback image(string, int) -> image;
    // Bumped as pictures arrive, so the cards that wait for one ask again.
    in-out property <int> loaded;
}

// ---------- Icons ----------

// Drawn as paths in a 24×24 viewbox, so they don't depend on what the font has.
component Icon inherits Rectangle {
    in property <string> name;
    in property <color> tint: Theme.text;
    in property <length> stroke: 1.8px;
    width: 18px;
    height: 18px;
    if root.name == "play": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M7 4.5v15l12.5-7.5z"; }
    if root.name == "pause": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M6 4.5h4.2v15H6zM13.8 4.5H18v15h-4.2z"; }
    if root.name == "prev": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M5 5h2.4v14H5zM9 12l10 7V5z"; }
    if root.name == "next": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M16.6 5H19v14h-2.4zM5 19l10-7L5 5z"; }
    if root.name == "close": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M6 6L18 18M18 6L6 18"; }
    if root.name == "back": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke + 0.4px; commands: "M15 4.5L7.5 12L15 19.5"; }
    if root.name == "search": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M10.5 4a6.5 6.5 0 1 1 0 13a6.5 6.5 0 1 1 0-13zM15.4 15.4L20 20"; }
    if root.name == "home": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M3.5 11L12 4l8.5 7M6 9v11h12V9M10 20v-5.5h4V20"; }
    if root.name == "movie": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4 4.5h16v15H4zM8 4.5v15M16 4.5v15M4 9.5h4M4 14.5h4M16 9.5h4M16 14.5h4"; }
    if root.name == "show": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M3 6h18v11.5H3zM8 21h8M12 17.5V21"; }
    if root.name == "artist": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M9 17.5V5.5l11-2v12M9 17.5a2.75 2.75 0 1 1-5.5 0a2.75 2.75 0 1 1 5.5 0zM20 15.5a2.75 2.75 0 1 1-5.5 0a2.75 2.75 0 1 1 5.5 0z"; }
    if root.name == "refresh": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M19.5 12a7.5 7.5 0 1 1-2.2-5.3M19.5 4v5h-5"; }
    if root.name == "lock": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M6 10.5h12v9.5H6zM8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"; }
    if root.name == "signout": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M14 4.5h5.5v15H14M10 8l-4 4l4 4M6 12h9"; }
    if root.name == "volume": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M3.5 9.5h3.5L11.5 5.5v13L7 14.5H3.5zM15 9a4 4 0 0 1 0 6M17.8 6.3a7.8 7.8 0 0 1 0 11.4"; }
    if root.name == "mute": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M3.5 9.5h3.5L11.5 5.5v13L7 14.5H3.5zM15.5 9.5l5 5M20.5 9.5l-5 5"; }
    if root.name == "replay": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M5 12a7 7 0 1 0 2.3-5.2M7 3v4h4"; }
    if root.name == "forward": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M19 12a7 7 0 1 1-2.3-5.2M17 3v4h-4"; }
    if root.name == "settings": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4 7h9M17 7h3M4 17h3M11 17h9M15 4.5v5M9 14.5v5"; }
    if root.name == "pip": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M3.5 5h17v14h-17zM12 12h6v5h-6z"; }
    if root.name == "fullscreen": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"; }
    if root.name == "exit-fullscreen": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M9 4v5H4M15 4v5h5M20 15h-5v5M4 15h5v5"; }
    if root.name == "list": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4 6h16M4 12h16M4 18h11"; }
    if root.name == "heart": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M12 20s-7.5-4.6-9.2-9.1C1.6 7.6 3.9 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8c1.2-1.7 2.8-2.8 4.8-2.8c3.3 0 5.6 3.1 4.4 6.4C19.5 15.4 12 20 12 20z"; }
    if root.name == "eye": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M2.5 12s3.5-6.5 9.5-6.5s9.5 6.5 9.5 6.5s-3.5 6.5-9.5 6.5S2.5 12 2.5 12zM12 9a3 3 0 1 1 0 6a3 3 0 1 1 0-6z"; }
    if root.name == "restart": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M5 5v6h6M5.6 11A7 7 0 1 1 7 17"; }
    if root.name == "person": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M12 4a4 4 0 1 1 0 8a4 4 0 1 1 0-8zM4.5 20c1-3.8 4-5.5 7.5-5.5s6.5 1.7 7.5 5.5"; }
    if root.name == "folder": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M3 6.5h6.5l2 2.5H21v10H3z"; }
    if root.name == "film": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4 4.5h16v15H4zM8 4.5v15M16 4.5v15M4 9.5h4M4 14.5h4M16 9.5h4M16 14.5h4"; }
    if root.name == "music": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M9 17.5V5.5l11-2v12M9 17.5a2.75 2.75 0 1 1-5.5 0a2.75 2.75 0 1 1 5.5 0zM20 15.5a2.75 2.75 0 1 1-5.5 0a2.75 2.75 0 1 1 5.5 0z"; }
    if root.name == "shuffle": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M3 7h3.5c2 0 3.1.9 4.2 2.5l2.6 4c1.1 1.6 2.2 2.5 4.2 2.5H21M18 13.5l3 2.5-3 2.5M3 17h3.5c1.5 0 2.5-.5 3.4-1.4M14.1 8.4c.9-.9 1.9-1.4 3.4-1.4H21M18 4.5l3 2.5-3 2.5"; }
    if root.name == "repeat": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4 12V10a3 3 0 0 1 3-3h13M17 4l3 3-3 3M20 12v2a3 3 0 0 1-3 3H4M7 20l-3-3 3-3"; }
    if root.name == "lyrics": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3zM5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7"; }
    if root.name == "repeat-one": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4 12V10a3 3 0 0 1 3-3h13M17 4l3 3-3 3M20 12v2a3 3 0 0 1-3 3H4M7 20l-3-3 3-3M11 10.8l1.4-1V14.2"; }
    if root.name == "plus": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke + 0.2px; commands: "M12 5v14M5 12h14"; }
    if root.name == "trash": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4.5 6.5h15M9.5 6.5V4h5v2.5M6.5 6.5l1 13h9l1-13"; }
    if root.name == "gauge": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M4 16a8 8 0 1 1 16 0M12 16l4.5-5"; }
    if root.name == "info": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke; commands: "M12 3.5a8.5 8.5 0 1 1 0 17a8.5 8.5 0 1 1 0-17zM12 11v5.5M12 7.6v0.4"; }
    if root.name == "chevron-down": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke + 0.4px; commands: "M6.5 9.5l5.5 5.5 5.5-5.5"; }
    if root.name == "check": Path { width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: root.stroke + 0.6px; commands: "M5 12.5l4.5 4.5L19 7.5"; }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> active: false;     // a mode that's on (repeat): accent icon
    in property <bool> focused: false;    // remote focus
    in property <length> size: 36px;
    in property <length> icon-size: 18px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.primary ? (ta.has-hover ? Theme.accent.brighter(10%) : Theme.accent) : (ta.has-hover || root.focused ? Theme.fill-hover : Theme.fill);
    border-width: root.focused ? 3px : 0px;
    border-color: white;
    Icon { name: root.icon; width: root.icon-size; height: root.icon-size; tint: root.primary ? Theme.accent-text : root.active ? Theme.accent : Theme.text; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> focused;
    callback clicked();
    height: 36px;
    width: row.preferred-width + 32px;
    border-radius: 8px;
    border-width: root.focused ? 3px : 0px;
    border-color: white;
    background: !root.enabled ? Theme.fill : root.primary ? (ta.has-hover ? Theme.accent.brighter(10%) : Theme.accent) : (ta.has-hover ? Theme.fill-hover : Theme.fill);
    row := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.icon != "": VerticalLayout { alignment: center; Icon { name: root.icon; width: 14px; height: 14px; tint: root.primary ? Theme.accent-text : Theme.text; } }
        Text {
            text: root.text;
            color: root.primary ? Theme.accent-text : Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; enabled: root.enabled; clicked => { root.clicked(); } }
}

component LinkText inherits Text {
    callback clicked();
    color: ta.has-hover ? Theme.accent.brighter(15%) : Theme.accent;
    font-size: 15px;
    font-weight: 600;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// ---------- Cards ----------

component PosterCard inherits Rectangle {
    in property <Poster> data;
    in property <bool> landscape: false;
    in property <bool> focused;
    // On or near the screen: only then is the picture kept.
    in property <bool> near: true;
    callback clicked();
    width: root.landscape ? 300px : 150px;
    height: art.height + 48px;

    art := Rectangle {
        y: 0;
        height: root.landscape ? 169px : root.data.square ? 150px : 225px;
        border-radius: root.landscape ? 12px : 10px;
        clip: true;
        // The focused card grows a little, so it's easy to follow from across the room.
        transform-scale: root.focused ? 1.07 : 1;
        animate transform-scale { duration: Theme.animate ? 160ms : 0ms; easing: ease-out; }
        background: Theme.card;
        drop-shadow-blur: ta.has-hover || root.focused ? 22px : 8px;
        drop-shadow-offset-y: ta.has-hover || root.focused ? 8px : 3px;
        drop-shadow-color: #00000090;
        property <string> icon:
            root.data.art-url == "icon:folder" ? "folder" : root.data.art-url == "icon:back" ? "back" :
            root.data.art-url == "icon:film" ? "film" : root.data.art-url == "icon:music" ? "music" : "";
        if icon == "": Text {
            text: root.data.title;
            color: Theme.tertiary;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
            width: parent.width - 20px;
            visible: img.source.width == 0;
        }
        if icon != "": Icon {
            name: icon;
            width: 44px;
            height: 44px;
            stroke: 1.4px;
            tint: icon == "folder" || icon == "back" ? Theme.accent : Theme.tertiary;
        }
        img := Image {
            width: parent.width;
            height: parent.height;
            source: root.data.image.width > 0 ? root.data.image : root.near && root.data.art-url != "" ? Art.image(root.data.art-url, Art.loaded) : @image-url("");
            image-fit: cover;
        }
        // Hover sheen; focus ring for keyboard / remote.
        Rectangle { background: ta.has-hover || root.focused ? #ffffff10 : transparent; }
        if root.focused: Rectangle {
            border-radius: parent.border-radius;
            border-width: 4px;
            border-color: white;
        }
        if root.data.watched: Rectangle {
            x: parent.width - 28px;
            y: 8px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: #000000a0;
            Icon { name: "check"; width: 12px; height: 12px; tint: Theme.accent; }
        }
        if root.data.progress > 0: Rectangle {
            y: parent.height - 5px;
            height: 5px;
            background: #00000070;
            Rectangle {
                x: 0;
                width: parent.width * root.data.progress;
                background: Theme.accent;
            }
        }
    }
    Text {
        y: art.height + (root.focused ? 16px : 9px);
        width: root.width;
        text: root.data.title;
        color: root.focused ? white : Theme.text;
        font-size: 14px;
        font-weight: root.focused ? 800 : 600;
        overflow: elide;
    }
    Text {
        y: art.height + (root.focused ? 35px : 28px);
        width: root.width;
        text: root.data.subtitle;
        color: Theme.secondary;
        font-size: 13px;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Shelf inherits VerticalLayout {
    in property <string> title;
    in property <[Poster]> items;
    in property <bool> landscape: false;
    in property <bool> square: false;
    in property <bool> see-all: false;
    in property <int> focused-index: -1;
    // The page's visible height: rows further away than half of it let their pictures go.
    in property <length> screen-h: 1200px;
    callback open(string);
    callback see-all-clicked();
    // Scrolled near the end: time to fetch the next titles.
    callback more();
    property <bool> on-screen: self.absolute-position.y < root.screen-h * 1.5 && self.absolute-position.y + self.height > -root.screen-h * 0.5;
    property <bool> near-end: root.on-screen && root.items.length > 0 && flick.width > 0
        && -flick.content-x + flick.width * 2 > root.items.length * (root.card-w + 22px);
    changed near-end => { if (self.near-end) { root.more(); } }
    // A remote/keyboard move glides; a drag or the trackpad moves at once.
    property <bool> glide;
    // Tells the page where the focused row is, so it can scroll it into view.
    callback reveal(length, length);
    spacing: 14px;
    changed focused-index => {
        if (root.focused-index >= 0) {
            root.glide = true;
            // Keep the focused card inside the row's visible part.
            if (root.focused-index * (root.card-w + 22px) < -flick.content-x) {
                flick.content-x = -(root.focused-index * (root.card-w + 22px));
            } else if (12px + (root.focused-index + 1) * (root.card-w + 22px) > -flick.content-x + flick.width) {
                flick.content-x = -(12px + (root.focused-index + 1) * (root.card-w + 22px) - flick.width + 10px);
            }
            root.reveal(self.absolute-position.y, self.preferred-height);
        }
    }
    property <length> card-w: root.landscape ? 300px : 150px;
    property <length> card-h: (root.landscape ? 169px : root.square ? 150px : 225px) + 48px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 32px;
        Text { text: root.title; color: Theme.text; font-size: 22px; font-weight: 700; vertical-alignment: bottom; }
        Rectangle { horizontal-stretch: 1; }
        if root.see-all: LinkText { text: "See All"; vertical-alignment: bottom; clicked => { root.see-all-clicked(); } }
    }
    flick := Flickable {
        height: root.card-h + 36px;     // room for the hover shadow and the focused card's growth
        content-width: root.items.length * (root.card-w + 22px) + 34px;
        animate content-x { duration: root.glide ? Theme.glide : 0ms; easing: ease-in-out; }
        flicked => { root.glide = false; }
        for p[i] in root.items: PosterCard {
            x: 12px + i * (root.card-w + 22px);
            y: 12px;
            near: root.on-screen && self.x + self.width > -flick.content-x - flick.width * 0.5 && self.x < -flick.content-x + flick.width * 1.5;
            data: p;
            landscape: root.landscape;
            focused: i == root.focused-index;
            clicked => { root.open(p.id); }
        }
    }
}

// ---------- Sign-in ----------

component SignIn inherits Rectangle {
    in property <string> code;
    in property <string> status;
    callback open-link();
    callback retry();
    callback skip();
    background: Theme.bg;
    VerticalLayout {
        alignment: center;
        spacing: 18px;
        Text { text: "Encheo"; color: Theme.accent; font-size: 44px; font-weight: 800; horizontal-alignment: center; }
        Text { text: "Connect your Plex account"; color: Theme.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
        Text { text: "Go to plex.tv/link and enter this code"; color: Theme.secondary; font-size: 14px; horizontal-alignment: center; }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 280px;
                height: 96px;
                border-radius: 14px;
                background: Theme.card;
                Text {
                    text: root.code == "" ? "····" : root.code;
                    color: Theme.text;
                    font-size: 52px;
                    font-weight: 800;
                    letter-spacing: 12px;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            Button { text: "Open plex.tv/link"; primary: true; clicked => { root.open-link(); } }
            Button { text: "New code"; clicked => { root.retry(); } }
        }
        HorizontalLayout {
            alignment: center;
            LinkText { text: "Continue without Plex"; font-size: 13px; clicked => { root.skip(); } }
        }
        Text { text: root.status; color: Theme.secondary; font-size: 13px; horizontal-alignment: center; }
    }
}

// ---------- Sidebar ----------

component SideRow inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <bool> focused;
    in property <bool> narrow;     // TV rail closed: the icon only
    callback clicked();
    height: Theme.tv ? 44px : 34px;
    border-radius: 8px;
    background: root.focused && Theme.tv ? white : root.active ? Theme.selection : ta.has-hover ? Theme.fill : transparent;
    border-width: root.focused && !Theme.tv ? 2px : 0px;
    border-color: Theme.accent;
    HorizontalLayout {
        padding-left: root.narrow ? 16px : 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout { alignment: center; Icon { name: root.icon; width: Theme.tv ? 22px : 19px; height: Theme.tv ? 22px : 19px; tint: root.focused && Theme.tv ? #111 : Theme.accent; } }
        if !root.narrow: Text {
            color: root.focused && Theme.tv ? #111 : Theme.text;
            font-size: Theme.tv ? 16px : 14px;
            text: root.text;
            font-weight: root.active || root.focused ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <bool> focused;
    callback search(string);
    callback leave();
    property <int> focus-request: Nav.search-request;
    // A text field can steal startup focus (Android then opens the on-screen keyboard), so the
    // field only accepts focus once someone clicks/taps it or selects it with the remote.
    property <bool> armed: false;
    changed focus-request => { root.armed = true; input.focus(); }
    height: 32px;
    border-radius: 8px;
    background: input.has-focus ? Theme.fill-hover : Theme.fill;
    border-width: input.has-focus || root.focused ? 1.5px : 0px;
    border-color: Theme.accent.with-alpha(0.7);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout { alignment: center; Icon { name: "search"; width: 15px; height: 15px; tint: Theme.secondary; } }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 0;
                text: "Search";
                color: Theme.tertiary;
                font-size: 14px;
                visible: input.text == "" && input.preedit-text == "";
            }
            if !root.armed: TouchArea {
                mouse-cursor: MouseCursor.text;
                clicked => { root.armed = true; input.focus(); }
            }
            input := TextInput {
                enabled: root.armed;
                text <=> root.text;
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.search(self.text); root.armed = false; root.leave(); }
                edited => { root.search(self.text); }
                // Phone keyboards hold back the word being typed until it's finished; search on
                // it as it grows, so results follow every letter.
                changed preedit-text => { root.search(self.text + self.preedit-text); }
                // Remote / keyboard: Down or Back leaves the field, so the keyboard closes.
                key-pressed(e) => {
                    if (e.text == Key.DownArrow || e.text == Key.Escape || e.text == Key.Back) {
                        root.armed = false;
                        root.leave();
                        return accept;
                    }
                    reject
                }
            }
        }
        if root.text != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.tertiary;
                Icon { name: "close"; width: 9px; height: 9px; stroke: 2.6px; tint: Theme.bg; }
                TouchArea { mouse-cursor: pointer; clicked => { root.text = ""; root.search(""); } }
            }
        }
    }
}

component Sidebar inherits Rectangle {
    in property <[LibraryEntry]> libraries;
    in property <int> selected;   // -1 = Home, -2 = search results
    in-out property <string> search-text;
    callback select(int);
    callback search(string);
    callback settings();
    // TV: a rail of icons until the remote moves into it; then it opens over the content.
    property <bool> open: !Theme.tv || (Nav.active && Nav.zone == "side");
    property <bool> narrow: !root.open;
    width: root.open ? 240px : Theme.rail-width;
    animate width { duration: Theme.animate ? 160ms : 0ms; easing: ease-out; }
    clip: true;
    background: Theme.tv ? (root.open ? #141416 : #17171a) : Theme.sidebar;
    drop-shadow-blur: Theme.tv && root.open ? 40px : 0px;
    drop-shadow-color: #000000c0;
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.separator; }
    VerticalLayout {
        padding: 12px;
        padding-top: Theme.tv ? 40px : Theme.sidebar-top;      // window buttons sit above (macOS)
        spacing: Theme.tv ? 6px : 2px;
        if !Theme.tv: SearchField {
            text <=> root.search-text;
            focused: Nav.active && Nav.zone == "side" && Nav.row == 0;
            search(q) => { root.search(q); }
            leave => { Nav.leave-search(); }
        }
        // TV: a page of its own with a keyboard for the remote.
        if Theme.tv: SideRow {
            text: "Search";
            icon: "search";
            narrow: root.narrow;
            active: root.selected == -2;
            focused: Nav.active && Nav.zone == "side" && Nav.row == 0;
            clicked => { Nav.tv-search(); }
        }
        Rectangle { height: 14px; }
        SideRow { text: "Home"; icon: "home"; narrow: root.narrow; active: root.selected == -1; focused: Nav.active && Nav.zone == "side" && Nav.row == 1; clicked => { root.select(-1); } }
        for lib[i] in root.libraries: VerticalLayout {
            vertical-stretch: 0;
            if !root.narrow && (i == 0 || root.libraries[i - 1].group != lib.group): Rectangle {
                height: 36px;
                vertical-stretch: 0;
                Text {
                    x: 0;
                    y: 18px;
                    text: lib.group;
                    color: Theme.tertiary;
                    font-size: 12px;
                    font-weight: 700;
                    overflow: elide;
                }
            }
            SideRow {
                text: lib.title;
                icon: lib.kind;
                narrow: root.narrow;
                active: root.selected == i;
                focused: Nav.active && Nav.zone == "side" && Nav.row == i + 2;
                clicked => { root.select(i); }
            }
        }
        Rectangle { vertical-stretch: 1; }
        // Sign out, sources and the rest live in Settings, out of the way.
        SideRow {
            text: "Settings";
            icon: "settings";
            narrow: root.narrow;
            focused: Nav.active && Nav.zone == "side" && Nav.row == root.libraries.length + 2;
            clicked => { root.settings(); }
        }
    }
}

// ---------- TV search keyboard ----------

component TvKey inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> focused;
    callback clicked();
    height: 46px;
    border-radius: 8px;
    background: root.focused ? white : ta.has-hover ? Theme.fill-hover : Theme.fill;
    if root.icon != "": HorizontalLayout {
        alignment: center;
        spacing: 8px;
        VerticalLayout { alignment: center; Icon { name: root.icon; width: 18px; height: 18px; tint: root.focused ? #111 : Theme.text; } }
        if root.label != "": Text { text: root.label; color: root.focused ? #111 : Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
    }
    if root.icon == "": Text {
        text: root.label;
        color: root.focused ? #111 : Theme.text;
        font-size: root.label.character-count > 1 ? 15px : 21px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Letters and digits in a 6-wide grid, then Space / Delete / Clear, each two keys wide. The remote
// focus is Nav zone "keys" (row 6 is the bottom row, its keys at columns 0, 2 and 4).
component TvKeyboard inherits Rectangle {
    in property <string> text;
    property <[string]> keys: ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r",
        "s", "t", "u", "v", "w", "x", "y", "z", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
    property <bool> nav: Nav.active && Nav.zone == "keys";
    property <length> pad: 48px;
    property <length> gap: 8px;
    property <length> key-w: (root.width - root.pad - 24px - 5 * root.gap) / 6;
    property <length> keys-y: 96px;
    // What's been typed.
    Rectangle {
        x: root.pad;
        y: 20px;
        width: root.width - root.pad - 24px;
        height: 56px;
        border-radius: 10px;
        background: Theme.fill;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            VerticalLayout { alignment: center; Icon { name: "search"; width: 20px; height: 20px; tint: Theme.secondary; } }
            Text {
                text: root.text == "" ? "Search" : root.text;
                color: root.text == "" ? Theme.tertiary : Theme.text;
                font-size: 22px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    for k[i] in root.keys: TvKey {
        x: root.pad + mod(i, 6) * (root.key-w + root.gap);
        y: root.keys-y + Math.floor(i / 6) * (46px + root.gap);
        width: root.key-w;
        label: k;
        focused: root.nav && Nav.row * 6 + Nav.col == i && Nav.row < 6;
        clicked => { Nav.tv-key(k); }
    }
    for k[i] in [{ key: "space", label: "Space", icon: "" }, { key: "delete", label: "Delete", icon: "" }, { key: "clear", label: "Clear", icon: "" }]: TvKey {
        x: root.pad + i * 2 * (root.key-w + root.gap);
        y: root.keys-y + 6 * (46px + root.gap);
        width: 2 * root.key-w + root.gap;
        label: k.label;
        icon: k.icon;
        focused: root.nav && Nav.row == 6 && Math.floor(Nav.col / 2) == i;
        clicked => { Nav.tv-key(k.key); }
    }
}

// ---------- Home ----------

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> focused;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: 16px;
    border-width: root.focused ? 3px : 0px;
    border-color: #ffffff;
    background: root.active ? Theme.accent : ta.has-hover ? Theme.fill-hover : Theme.fill;
    label := Text { text: root.text; color: root.active ? Theme.accent-text : Theme.text; font-size: 14px; font-weight: 600; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component FilterChipView inherits Rectangle {
    in property <FilterChip> data;
    in property <bool> focused;
    callback clicked();
    height: Theme.tv ? 40px : 32px;
    width: row.preferred-width + (Theme.tv ? 36px : 28px);
    border-radius: self.height / 2;
    border-width: root.focused ? 3px : 0px;
    border-color: #ffffff;
    background: root.data.active ? Theme.accent : ta.has-hover || root.focused ? Theme.fill-hover : Theme.fill;
    row := HorizontalLayout {
        alignment: center;
        spacing: 4px;
        Text { text: root.data.text; color: root.data.active ? Theme.accent-text : Theme.text; font-size: Theme.tv ? 17px : 14px; font-weight: 600; vertical-alignment: center; }
        if root.data.menu: VerticalLayout {
            alignment: center;
            Icon { name: "chevron-down"; width: Theme.tv ? 18px : 15px; height: self.width; tint: root.data.active ? Theme.accent-text : Theme.secondary; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret;
    in-out property <string> text;
    spacing: 6px;
    Text { text: root.label; color: Theme.secondary; font-size: 12px; font-weight: 600; }
    Rectangle {
        height: 36px;
        border-radius: 8px;
        background: input.has-focus ? Theme.fill-hover : Theme.fill;
        border-width: input.has-focus ? 1.5px : 0px;
        border-color: Theme.accent.with-alpha(0.7);
        Text {
            x: 12px;
            text: root.placeholder;
            color: Theme.tertiary;
            font-size: 14px;
            visible: input.text == "";
        }
        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            text <=> root.text;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            single-line: true;
            input-type: root.secret ? InputType.password : InputType.text;
        }
    }
}

component AddSourceDialog inherits Rectangle {
    in property <bool> busy;
    in property <string> status;
    in property <[FoundSource]> found;
    in property <bool> scanning;
    in property <bool> editing;
    callback connect(int, string, string, string, string);
    callback cancel();
    in-out property <int> kind: 1;   // 0 folder, 1 SMB, 2 WebDAV, 3 Jellyfin/Emby, … 8 Plex
    in-out property <string> name;
    in-out property <string> location;
    in-out property <string> user;
    in-out property <string> password;
    background: #000000a0;
    TouchArea { }   // block clicks to what's behind
    Rectangle {
        width: Math.min(480px, root.width - 32px);
        height: form.preferred-height;
        border-radius: 16px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.separator;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000b0;
        form := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text { text: root.editing ? "Edit Source" : "Add a Source"; color: Theme.text; font-size: 20px; font-weight: 700; }
            if !root.editing && (root.found.length > 0 || root.scanning): VerticalLayout {
                spacing: 6px;
                Text { text: root.scanning ? "Looking on your network…" : "On your network"; color: Theme.secondary; font-size: 12px; font-weight: 600; }
                for f in root.found: Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: fta.has-hover ? Theme.fill-hover : Theme.fill;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: f.label; color: Theme.accent; font-size: 12px; font-weight: 700; vertical-alignment: center; width: 64px; }
                        Text { text: f.name; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        Text { text: f.address; color: Theme.tertiary; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; horizontal-stretch: 1; }
                    }
                    fta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.kind = f.kind;
                            root.location = f.address;
                            if (f.kind != 3) { root.name = f.name; }
                        }
                    }
                }
            }
            // Two rows: media servers and the common shares first. An edit keeps its kind.
            if !root.editing: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for k in [{ i: 8, t: "Plex" }, { i: 3, t: "Jellyfin / Emby" }, { i: 1, t: "SMB" }, { i: 0, t: "Folder" }]: Chip { text: k.t; active: root.kind == k.i; clicked => { root.kind = k.i; } }
            }
            if !root.editing: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for k in [{ i: 2, t: "WebDAV" }, { i: 4, t: "SFTP" }, { i: 5, t: "FTP" }, { i: 6, t: "NFS" }, { i: 7, t: "DLNA" }]: Chip { text: k.t; active: root.kind == k.i; clicked => { root.kind = k.i; } }
            }
            // Not media: where to ask for what you don't have.
            if !root.editing: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Chip { text: "Seerr requests"; active: root.kind == 9; clicked => { root.kind = 9; } }
            }
            Text {
                color: Theme.secondary;
                font-size: 12px;
                wrap: word-wrap;
                text: root.kind == 0 ? "A folder on this computer, or a share your system has already mounted."
                    : root.kind == 1 ? "A Windows share or NAS, e.g. smb://nas.local/Media or smb://192.168.1.10/Movies."
                    : root.kind == 2 ? "A WebDAV server, e.g. https://nas.local:5006/video."
                    : root.kind == 3 ? "A Jellyfin or Emby server, e.g. http://192.168.1.10:8096. Your libraries appear in the sidebar."
                    : root.kind == 4 ? "A server you can reach over SSH, e.g. sftp://nas.local/volume1/video."
                    : root.kind == 5 ? "An FTP server, e.g. ftp://nas.local/video (ftps:// for encrypted)."
                    : root.kind == 6 ? "An NFS export, e.g. nfs://nas.local/volume1/video. No sign-in needed."
                    : root.kind == 8 ? "Your Plex account. You'll get a code to enter at plex.tv/link, and your server's libraries appear in the sidebar."
                    : root.kind == 9 ? "Seerr, Overseerr or Jellyseerr, e.g. https://requests.example.com. Titles you don't have get a Request button. Leave the user name blank to sign in with your Plex account."
                    : "A DLNA/UPnP media server (many NAS boxes and TVs). Pick it from the list above when it shows up.";
            }
            if root.kind != 8: Field {
                label: root.kind == 0 ? "Folder" : "Address";
                placeholder: root.kind == 0 ? "/Users/you/Movies" : root.kind == 1 ? "smb://server/share" : root.kind == 2 ? "https://server/path"
                    : root.kind == 3 ? "http://server:8096" : root.kind == 4 ? "sftp://server/path" : root.kind == 5 ? "ftp://server/path"
                    : root.kind == 6 ? "nfs://server/export" : root.kind == 9 ? "https://requests.example.com" : "http://server:8200/rootDesc.xml";
                text <=> root.location;
            }
            if root.kind != 0 && root.kind != 6 && root.kind != 7 && root.kind != 8: HorizontalLayout {
                spacing: 12px;
                Field { label: root.kind == 9 ? "User name or email" : "User name"; placeholder: root.kind == 1 ? "guest" : root.kind == 9 ? "Blank: your Plex account" : ""; text <=> root.user; }
                Field { label: "Password"; secret: true; placeholder: root.editing && root.kind != 9 ? "Unchanged" : ""; text <=> root.password; }
            }
            if root.kind != 3 && root.kind != 8 && root.kind != 9: Field { label: "Name (optional)"; placeholder: "Shown in the sidebar"; text <=> root.name; }
            if root.status != "": Text { text: root.status; color: root.busy ? Theme.secondary : #ff8f80; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button {
                    text: root.busy ? "Connecting…" : root.kind == 3 || root.kind == 8 || root.kind == 9 ? "Sign In" : root.editing ? "Save" : "Connect";
                    primary: true;
                    enabled: !root.busy && (root.location != "" || root.kind == 8);
                    clicked => { root.connect(root.kind, root.name, root.location, root.user, root.password); }
                }
            }
        }
    }
}

// Every source in one list: Plex, Jellyfin/Emby servers, then file sources. Edit and Remove per
// row; Remove asks first, in the row itself.
// Settings: where the media comes from (add, edit, remove, Plex sign-in/out), refresh and About.
// Kept out of the way so a stray click or remote press can't sign anyone out.
// Under a Request button: how far the download is, and what's happening.
component PlayStatus inherits VerticalLayout {
    in property <float> progress: -1;
    in property <string> note;
    spacing: 6px;
    if root.progress >= 0: Rectangle {
        height: 4px;
        border-radius: 2px;
        background: #ffffff30;
        Rectangle {
            x: 0;
            width: parent.width * Math.max(0, Math.min(1, root.progress));
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    if root.note != "": Text { text: root.note; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
}

// A setting that's on or off: title, a line of detail, and a switch.
component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> on;
    in property <bool> focused;
    callback toggled();
    min-height: 56px;
    border-radius: 10px;
    background: ta.has-hover ? Theme.fill-hover : Theme.fill;
    border-width: root.focused ? 3px : 0px;
    border-color: white;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 600; }
            Text { text: root.detail; color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 46px;
                height: 28px;
                border-radius: 14px;
                background: root.on ? Theme.accent : #ffffff30;
                Rectangle {
                    x: root.on ? parent.width - self.width - 3px : 3px;
                    animate x { duration: Theme.animate ? 150ms : 0ms; easing: ease-out; }
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: white;
                }
            }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

component SettingsDialog inherits Rectangle {
    in property <[SourceRow]> sources;
    in-out property <int> confirm: -1;   // the row asking "Remove?"
    // Remote focus, set by Rust: rows are the sources, then the bottom buttons.
    in property <int> focus-row: -1;
    in property <int> focus-col: -1;
    callback add();
    callback edit(string, int);
    callback remove(string, int);
    callback sign-in();
    callback refresh();
    callback about();
    callback close();
    // Desktop: switch the TV look on or off (a computer connected to a TV).
    in property <bool> can-tv-mode;
    callback tv-mode();
    callback animations();
    // Android: what the TV and sound output take as is (empty elsewhere), and the switch.
    in property <string> direct-info;
    in property <bool> direct-on;
    callback direct();
    // Plex Home with two or more people: "Profiles" on the Plex row.
    in property <bool> can-switch-profile;
    callback switch-profile();
    property <int> buttons-row: root.sources.length + (root.direct-info != "" ? 2 : 1);
    function f(r: int, c: int) -> bool { return root.focus-row == r && root.focus-col == c; }
    changed focus-row => {
        if (root.focus-row >= 0 && root.focus-row < root.sources.length) {
            if (root.focus-row * 68px < -flick.content-y) {
                flick.content-y = -(root.focus-row * 68px);
            } else if ((root.focus-row + 1) * 68px > -flick.content-y + flick.height) {
                flick.content-y = -((root.focus-row + 1) * 68px - flick.height);
            }
        }
    }
    background: #000000a0;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: Math.min(600px, root.width - 32px);
        height: box.preferred-height;
        border-radius: 16px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.separator;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000b0;
        TouchArea { }
        box := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            HorizontalLayout {
                Text { text: "Settings"; color: Theme.text; font-size: 22px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if !Theme.tv: IconButton { icon: "close"; size: 32px; icon-size: 14px; clicked => { root.close(); } }
            }
            Text { text: "Sources: where your films, shows and music come from."; color: Theme.secondary; font-size: 13px; wrap: word-wrap; }
            flick := Flickable {
                height: Math.min(list.preferred-height, root.height - 260px);
                content-height: list.preferred-height;
                list := VerticalLayout {
                    spacing: 8px;
                    for row[i] in root.sources: Rectangle {
                        height: 60px;
                        border-radius: 10px;
                        background: root.confirm == i ? Theme.fill-hover : Theme.fill;
                        if root.confirm != i: HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout { alignment: center; Icon { name: row.kind == "files" ? "folder" : row.kind == "seerr" ? "plus" : "film"; width: 20px; height: 20px; tint: Theme.accent; } }
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: row.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text { text: row.label; color: Theme.accent; font-size: 11px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                }
                                Text { text: row.detail; color: Theme.tertiary; font-size: 12px; overflow: elide; }
                            }
                            if row.kind == "plex" && !row.signed-in: VerticalLayout { alignment: center; Button { text: "Sign In"; primary: true; focused: root.f(i, 0); clicked => { root.sign-in(); } } }
                            if row.kind != "plex": VerticalLayout { alignment: center; Button { text: "Edit"; focused: root.f(i, 0); clicked => { root.edit(row.kind, row.index); } } }
                            if row.kind == "plex" && row.signed-in && root.can-switch-profile: VerticalLayout { alignment: center; Button { text: "Profiles"; icon: "person"; focused: root.f(i, 0); clicked => { root.switch-profile(); } } }
                            if row.kind != "plex" || row.signed-in: VerticalLayout {
                                alignment: center;
                                Button {
                                    text: row.kind == "plex" ? "Sign Out" : "Remove";
                                    focused: root.f(i, row.kind == "plex" && !root.can-switch-profile ? 0 : 1);
                                    clicked => { root.confirm = i; }
                                }
                            }
                        }
                        if root.confirm == i: HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 10px;
                            Text {
                                text: row.kind == "plex" ? "Sign out of Plex on this device?" : "Remove “" + row.title + "” from Encheo?";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            VerticalLayout { alignment: center; Button { text: "Cancel"; focused: root.f(i, 0); clicked => { root.confirm = -1; } } }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: row.kind == "plex" ? "Sign Out" : "Remove";
                                    primary: true;
                                    focused: root.f(i, 1);
                                    clicked => {
                                        root.confirm = -1;
                                        root.remove(row.kind, row.index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // On/off, right under the sources.
            SwitchRow {
                title: "Animations";
                detail: "Smooth scrolling and transitions";
                on: Theme.animate;
                focused: root.f(root.sources.length, 0);
                toggled => { root.animations(); }
            }
            if root.direct-info != "": SwitchRow {
                title: "HDR and surround to the TV (experimental)";
                detail: root.direct-info;
                on: root.direct-on;
                focused: root.f(root.sources.length + 1, 0);
                toggled => { root.direct(); }
            }
            HorizontalLayout {
                spacing: 10px;
                padding-top: 4px;
                Button { text: "Refresh"; icon: "refresh"; focused: root.f(root.buttons-row, 0); clicked => { root.refresh(); } }
                Button { text: "About"; icon: "info"; focused: root.f(root.buttons-row, 1); clicked => { root.about(); } }
                if root.can-tv-mode: Button {
                    text: Theme.tv ? "Leave TV Mode" : "TV Mode";
                    icon: "show";
                    focused: root.f(root.buttons-row, 2);
                    clicked => { root.tv-mode(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Add Source"; icon: "plus"; primary: true; focused: root.f(root.buttons-row, root.can-tv-mode ? 3 : 2); clicked => { root.add(); } }
            }
        }
    }
}

// Netflix-style buttons: white for the main action, grey glass for the rest.
component Pill inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> light;
    in property <bool> focused;
    callback clicked();
    height: Theme.tv ? 50px : 44px;
    width: row.preferred-width + 40px;
    Rectangle {
        border-radius: 8px;
        background: root.light ? (ta.has-hover ? #ffffffd8 : white) : (ta.has-hover ? #8a8a8cb8 : #6d6d6ea0);
        transform-scale: root.focused ? 1.06 : 1;
        animate transform-scale { duration: Theme.animate ? 140ms : 0ms; easing: ease-out; }
        row := HorizontalLayout {
            alignment: center;
            spacing: 10px;
            if root.icon != "": VerticalLayout { alignment: center; Icon { name: root.icon; width: 18px; height: 18px; stroke: 2.2px; tint: root.light ? #111 : white; } }
            Text { text: root.text; color: root.light ? #111 : white; font-size: Theme.tv ? 18px : 16px; font-weight: 700; vertical-alignment: center; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component BillboardView inherits Rectangle {
    in property <Billboard> data;
    in property <bool> compact;
    in property <length> pad;
    in property <length> top-space;      // the header floats over the picture
    in property <int> focused-col: -1;   // remote focus: 0 Play, 1 More Info
    // TV Home: the picture fills the screen behind the first row; the text sits above that row.
    in property <length> text-bottom: 0;
    in property <bool> show-summary: true;
    callback play();
    callback info();
    clip: true;
    Image { width: parent.width; height: parent.height; source: root.data.image; image-fit: cover; }
    // Darken the left for the text, then fade into the page so there's no edge at the bottom.
    if !root.compact: Rectangle { background: @linear-gradient(90deg, #000000b0 0%, #00000000 62%); }
    if root.text-bottom == 0: Rectangle { background: @linear-gradient(180deg, #00000080 0%, #00000000 25%, #1c1c1e00 55%, Theme.bg 100%); }
    if root.text-bottom > 0: Rectangle { background: @linear-gradient(180deg, #00000080 0%, #00000000 20%, #00000000 40%, Theme.bg.with-alpha(0.8) 70%, Theme.bg 100%); }
    TouchArea { clicked => { root.info(); } }
    VerticalLayout {
        x: root.pad;
        y: parent.height - self.height - root.text-bottom - (root.compact ? 12px : root.text-bottom > 0 ? 20px : 36px);
        width: root.compact ? parent.width - 2 * root.pad : Math.min(parent.width * 0.5, 620px);
        height: self.preferred-height;
        spacing: 12px;
        if root.data.logo.width > 0: Image {
            source: root.data.logo;
            height: root.compact ? 70px : 120px;
            image-fit: contain;
            horizontal-alignment: root.compact ? center : left;
        }
        if root.data.logo.width == 0: Text {
            text: root.data.title;
            color: white;
            font-size: root.compact ? 30px : Theme.tv ? 50px : 44px;
            font-weight: 800;
            wrap: word-wrap;
            horizontal-alignment: root.compact ? center : left;
        }
        Text {
            text: root.data.meta;
            color: #ffffffcc;
            font-size: root.compact ? 13px : 16px;
            font-weight: 600;
            horizontal-alignment: root.compact ? center : left;
            overflow: elide;
        }
        if !root.compact && root.show-summary && root.data.summary != "": Text {
            text: root.data.summary;
            color: #ffffffe6;
            font-size: Theme.tv ? 18px : 16px;
            wrap: word-wrap;
            max-height: 3 * (Theme.tv ? 25px : 22px);
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 12px;
            padding-top: 6px;
            alignment: root.compact ? center : start;
            Pill {
                text: root.data.play-label;
                icon: "play";
                light: root.focused-col != 1;
                focused: root.focused-col == 0;
                clicked => { root.play(); }
            }
            Pill {
                text: "More Info";
                icon: "info";
                light: root.focused-col == 1;
                focused: root.focused-col == 1;
                clicked => { root.info(); }
            }
        }
    }
}

component TrackRow inherits Rectangle {
    in property <Track> data;
    in property <bool> focused;
    callback clicked();
    callback reveal(length, length);
    changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.accent;
    height: 46px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.fill : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            width: 24px;
            if root.data.playing: Icon { name: "play"; width: 12px; height: 12px; tint: Theme.accent; }
            if !root.data.playing: Text { text: root.data.number; color: Theme.tertiary; font-size: 13px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.data.title; color: root.data.playing ? Theme.accent : Theme.text; font-size: 14px; font-weight: 500; overflow: elide; }
            if root.data.artist != "": Text { text: root.data.artist; color: Theme.secondary; font-size: 12px; overflow: elide; }
        }
        Text { text: root.data.runtime; color: Theme.secondary; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; width: 56px; }
    }
    Rectangle { x: 54px; y: parent.height - 1px; width: parent.width - 54px; height: 1px; background: Theme.separator; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Home inherits Rectangle {
    in property <[LibraryEntry]> libraries;
    in property <int> selected;
    in property <[Poster]> continue-watching;
    in property <[HomeRow]> rows;
    in property <Billboard> billboard;
    in property <[Poster]> grid;
    in property <string> grid-title;
    in property <bool> grid-square;
    in property <bool> loading;
    in property <length> bottom-inset;
    in property <[string]> tabs;          // music libraries: Artists, Albums, Songs, Playlists
    in property <int> tab;
    in property <[Track]> songs;          // the Songs tab, shown as a list
    callback select-tab(int);
    in property <[FilterChip]> filters;   // movie and TV libraries: Sort, Genre, …
    in property <[AzLetter]> az;          // sorted by title: the A–Z rail
    in property <[HomeRow]> search-rows;  // search: suggestions under the results
    callback filter-chip(int);
    property <length> tabs-h: (root.tabs.length > 0 || root.filters.length > 0) && root.selected >= 0 ? (Theme.tv ? 60px : 52px) : 0px;
    in-out property <string> search-text;
    in property <bool> can-speed-test;
    callback speed-test();
    callback select(int);
    callback open(string);
    callback search(string);
    callback settings();
    callback billboard-play();
    // Home row `i` was scrolled near its end.
    callback row-more(int);
    background: Theme.bg;

    // Phones and narrow windows: no sidebar; search and library chips across the top instead.
    property <bool> compact: root.width < 720px;
    // TV: the sidebar is a rail of icons that opens over the content, so the content stays put.
    property <length> content-x: root.compact ? 0 : Theme.tv ? Theme.rail-width : side.width;
    property <length> content-w: root.width - root.content-x;
    property <length> top: root.compact ? Theme.header-height + 92px : Theme.header-height;
    property <length> pad: root.compact ? 16px : Theme.tv ? 48px : 32px;
    property <bool> has-billboard: root.billboard.id != "";
    // Wide screens: the header floats over the billboard's picture.
    property <length> home-top: root.has-billboard && !root.compact ? 0 : root.top;
    // TV: the billboard stays put at the top and shows the title the remote is on (lib.rs
    // tv_hero_follow); the rows scroll underneath it.
    property <bool> tv-home: Theme.tv && !root.compact && root.has-billboard;
    // The rows start low enough that the first one (Continue Watching's landscape cards) shows
    // in full, as on Netflix; the hero's picture fills the screen behind it.
    property <length> shelves-top-target: root.tv-home && !root.browsing ? Math.max(root.height * 0.5, root.height - 330px) : root.tv-home ? root.top : root.home-top;
    property <length> shelves-top: self.shelves-top-target;
    animate shelves-top { duration: Theme.animate ? 300ms : 0ms; easing: ease-in-out; }
    // TV: past the first row the hero makes way so more rows fit, as in Plex; it comes back at
    // the top.
    // (Or scrolled down with a trackpad or mouse, in TV mode on a computer.)
    property <bool> browsing: root.tv-home && ((root.nav-content && Nav.row > root.bb-rows) || root.scrolled);
    // Set when the user scrolls (not from the scroll position itself: the rows' position depends
    // on `browsing`, which would loop).
    property <bool> scrolled;

    // Compact: search and library chips under the header.
    if root.compact: VerticalLayout {
        y: Theme.header-height;
        height: 92px;
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 10px;
        SearchField {
            text <=> root.search-text;
            search(q) => { root.search(q); }
        }
        Flickable {
            height: 34px;
            content-width: chips.preferred-width;
            chips := HorizontalLayout {
                spacing: 8px;
                Chip { text: "Home"; active: root.selected == -1; clicked => { root.select(-1); } }
                for lib[i] in root.libraries: Chip { text: lib.title; active: root.selected == i; clicked => { root.select(i); } }
            }
        }
    }

    // Keyboard/remote focus helpers.
    property <bool> nav-content: Nav.active && Nav.zone == "content";
    property <int> bb-rows: root.has-billboard ? 1 : 0;
    property <int> cw-rows: root.continue-watching.length > 0 ? 1 : 0;
    property <int> nav-row: root.nav-content ? Nav.row : -1;
    changed nav-row => { if (self.nav-row == 0 && root.has-billboard) { root.v-glide = true; shelf-view.content-y = 0; } }
    // A remote/keyboard move glides up and down; a drag or the trackpad moves at once.
    property <bool> v-glide;

    // Scroll the shelves so a focused row (window coordinates) sits in the middle of the view,
    // as far as the list's ends allow.
    function reveal(top: length, height: length) {
        root.v-glide = true;
        root.scrolled = false;
        let in-content = top - shelf-view.absolute-position.y - shelf-view.content-y;
        // (Where the rows will start once the banner has finished folding away or coming back.)
        let view-h = root.height - root.shelves-top-target - root.bottom-inset;
        let target = -(in-content - Math.max(0px, (view-h - height) / 2));
        shelf-view.content-y = Math.max(Math.min(0px, root.height - root.shelves-top-target - shelf-view.content-height), Math.min(0px, target));
    }

    if root.tv-home && root.selected == -1: BillboardView {
        opacity: root.browsing ? 0 : 1;
        animate opacity { duration: Theme.animate ? 300ms : 0ms; }
        x: root.content-x;
        y: 0;
        width: root.content-w;
        height: root.height;
        text-bottom: root.height - root.shelves-top;
        show-summary: root.shelves-top >= 330px;
        data: root.billboard;
        compact: false;
        pad: root.pad;
        focused-col: root.nav-content && Nav.row == 0 ? Nav.col : -1;
        play => { root.billboard-play(); }
        info => { root.open(root.billboard.id); }
    }

    // Home: billboard, then shelves.
    shelf-view := Flickable {
        visible: root.selected == -1;
        x: root.content-x;
        y: root.shelves-top;
        width: root.content-w;
        height: root.height - root.shelves-top;
        content-height: shelves.preferred-height;
        animate content-y { duration: root.v-glide ? Theme.glide : 0ms; easing: ease-in-out; }
        flicked => {
            root.v-glide = false;
            root.scrolled = self.content-y < -40px;
        }
        shelves := VerticalLayout {
            padding-bottom: 32px + root.bottom-inset;
            if root.has-billboard && !root.tv-home: BillboardView {
                height: root.compact ? Math.min(root.content-w * 1.15, 560px) : Math.max(420px, Math.min(root.height * 0.68, root.content-w * 0.5));
                data: root.billboard;
                compact: root.compact;
                pad: root.pad;
                focused-col: root.nav-content && Nav.row == 0 ? Nav.col : -1;
                play => { root.billboard-play(); }
                info => { root.open(root.billboard.id); }
            }
            VerticalLayout {
                padding-left: root.pad - 12px;
                padding-top: 8px;
                spacing: 28px;
                if root.continue-watching.length > 0: Shelf {
                    title: "Continue Watching";
                    items: root.continue-watching;
                    landscape: true;
                    screen-h: root.height;
                    focused-index: root.nav-content && Nav.row == root.bb-rows ? Nav.col : -1;
                    open(id) => { root.open(id); }
                    reveal(t, hh) => { root.reveal(t, hh); }
                }
                for row[ri] in root.rows: Shelf {
                    screen-h: root.height;
                    more => { root.row-more(ri); }
                    focused-index: root.nav-content && Nav.row == ri + root.bb-rows + root.cw-rows ? Nav.col : -1;
                    reveal(t, hh) => { root.reveal(t, hh); }
                    title: row.title;
                    items: row.items;
                    landscape: row.landscape;
                    square: row.square;
                    see-all: row.library >= 0;
                    open(id) => { root.open(id); }
                    see-all-clicked => { root.select(row.library); }
                }
                if root.continue-watching.length == 0 && root.rows.length == 0 && !root.loading: Text {
                    text: "Nothing here yet.";
                    color: Theme.secondary;
                }
            }
        }
    }

    // TV search: the keyboard sits left of the results.
    property <length> keyboard-w: Theme.tv && root.selected == -2 ? 440px : 0px;
    if root.keyboard-w > 0: TvKeyboard {
        x: root.content-x;
        y: root.top;
        width: root.keyboard-w;
        height: root.height - root.top;
        text: root.search-text;
    }

    // A library or search results: wrapping grid.
    if root.tabs.length > 0 && root.selected >= 0: HorizontalLayout {
        x: root.content-x + root.pad;
        y: root.top + 8px;
        width: root.content-w - 2 * root.pad;
        height: 36px;
        spacing: 8px;
        alignment: start;
        for t[i] in root.tabs: Chip {
            text: t;
            active: i == root.tab;
            focused: Nav.active && Nav.zone == "tabs" && Nav.col == i;
            clicked => { root.select-tab(i); }
        }
    }

    // Movie and TV libraries: sort and filters. Scrolls sideways where it doesn't fit (phones).
    if root.filters.length > 0 && root.selected >= 0: Flickable {
        x: root.content-x + root.pad;
        y: root.top + 8px;
        width: root.content-w - 2 * root.pad;
        height: Theme.tv ? 44px : 36px;
        content-width: fbar.preferred-width;
        fbar := HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for f[i] in root.filters: FilterChipView {
                data: f;
                focused: Nav.active && Nav.zone == "filters" && Nav.col == i;
                clicked => { root.filter-chip(i); }
            }
        }
    }

    if root.selected != -1: gridbox := Rectangle {
        x: root.content-x + root.keyboard-w;
        y: root.top + root.tabs-h;
        width: root.content-w - root.keyboard-w;
        height: root.height - root.top - root.tabs-h;
        property <bool> list: root.songs.length > 0;
        property <length> card-w: 150px;
        property <length> card-h: self.list ? 46px : root.grid-square ? 214px : 289px;
        property <length> gap: self.list ? 0px : 22px;
        property <length> pad: root.pad;
        // Sorted by title: the A–Z rail on the right.
        property <length> rail-w: root.az.length > 0 && root.selected >= 0 && !self.list ? (Theme.tv ? 44px : 28px) : 0px;
        property <int> cols: self.list ? 1 : max(1, floor((self.width - 2 * self.pad - self.rail-w + self.gap) / (self.card-w + self.gap)));
        // Scroll so title `index` is in the top row.
        function jump(index: int, glide: bool) {
            if (index < 0) { return; }
            self.glide = glide;
            grid-view.content-y = max(min(0px, grid-view.height - grid-view.content-height), -(floor(index / self.cols) * (self.card-h + self.gap)));
        }
        // The letter the remote is on, or the mouse or finger is dragging over.
        property <int> az-row: Nav.active && Nav.zone == "az" ? Nav.row : -1;
        property <int> scrub: -1;
        changed az-row => { if (self.az-row >= 0 && self.az-row < root.az.length) { self.jump(root.az[self.az-row].index, true); } }
        init => { Nav.grid-cols = self.cols; }
        changed cols => { Nav.grid-cols = self.cols; }
        // Search: rows of suggestions follow the grid's rows, for the remote too.
        property <int> grid-rows: self.list ? root.songs.length : ceil(root.grid.length / self.cols);
        property <length> grid-h: self.grid-rows * (self.card-h + self.gap);
        // Scroll a suggestions row (window coordinates) into the middle of the view.
        function reveal(top: length, height: length) {
            self.glide = true;
            let in-content = top - grid-view.absolute-position.y - grid-view.content-y;
            let view-h = grid-view.height - root.bottom-inset;
            let target = -(in-content - Math.max(0px, (view-h - height) / 2));
            grid-view.content-y = Math.max(Math.min(0px, grid-view.height - grid-view.content-height), Math.min(0px, target));
        }
        // Keep the focused card's row in view.
        property <int> focus-row: root.nav-content ? Nav.row : -1;
        property <bool> glide;
        changed focus-row => {
            if (self.focus-row >= 0 && self.focus-row < self.grid-rows) {
                self.glide = true;
                if (12px + self.focus-row * (self.card-h + self.gap) < -grid-view.content-y) {
                    grid-view.content-y = -(self.focus-row * (self.card-h + self.gap));
                } else if (12px + (self.focus-row + 1) * (self.card-h + self.gap) > -grid-view.content-y + grid-view.height - root.bottom-inset) {
                    grid-view.content-y = -(12px + (self.focus-row + 1) * (self.card-h + self.gap) - grid-view.height + 16px + root.bottom-inset);
                }
            }
        }
        grid-view := Flickable {
            content-height: gridbox.grid-h + (root.search-rows.length > 0 ? srows.preferred-height + 24px : 0px) + gridbox.pad + root.bottom-inset;
            animate content-y { duration: gridbox.glide ? Theme.glide : 0ms; easing: ease-in-out; }
            flicked => { gridbox.glide = false; }
            if !gridbox.list: Rectangle {
                for p[i] in root.grid: PosterCard {
                    x: gridbox.pad + mod(i, gridbox.cols) * (gridbox.card-w + gridbox.gap);
                    y: 12px + Math.floor(i / gridbox.cols) * (gridbox.card-h + gridbox.gap);
                    near: self.y + self.height > -grid-view.content-y - grid-view.height * 0.5 && self.y < -grid-view.content-y + grid-view.height * 1.5;
                    data: p;
                    focused: root.nav-content && Nav.row * gridbox.cols + Nav.col == i;
                    clicked => { root.open(p.id); }
                }
            }
            srows := VerticalLayout {
                x: gridbox.pad - 12px;
                y: 12px + gridbox.grid-h + (root.grid.length > 0 ? 12px : 0px);
                width: gridbox.width - self.x;
                height: self.preferred-height;
                alignment: start;
                spacing: 18px;
                for row[ri] in root.search-rows: Shelf {
                    title: row.title;
                    items: row.items;
                    landscape: row.landscape;
                    square: row.square;
                    screen-h: grid-view.height;
                    focused-index: root.nav-content && Nav.row == gridbox.grid-rows + ri ? Nav.col : -1;
                    reveal(t, h) => { gridbox.reveal(t, h); }
                    open(id) => { root.open(id); }
                }
            }
            if gridbox.list: Rectangle {
                for t[i] in root.songs: TrackRow {
                    x: gridbox.pad;
                    y: 12px + i * gridbox.card-h;
                    width: min(940px, gridbox.width - 2 * gridbox.pad);
                    data: t;
                    focused: root.nav-content && Nav.row == i;
                    clicked => { root.open(t.id); }
                }
            }
        }
        if root.selected == -2 && root.grid.length == 0 && root.search-rows.length == 0 && !root.loading: Text {
            text: root.search-text == "" ? "Pick letters to search" : "No results";
            color: Theme.secondary;
            font-size: 15px;
        }
        if root.selected >= 0 && root.filters.length > 0 && root.grid.length == 0 && !root.loading: Text {
            text: "Nothing matches these filters";
            color: Theme.secondary;
            font-size: Theme.tv ? 20px : 15px;
        }
        if gridbox.rail-w > 0: rail := Rectangle {
            x: gridbox.width - gridbox.rail-w - (Theme.tv ? 12px : 4px);
            y: 8px;
            width: gridbox.rail-w;
            height: gridbox.height - 16px - root.bottom-inset;
            property <length> step: min(Theme.tv ? 30px : 21px, self.height / root.az.length);
            property <length> top-y: (self.height - self.step * root.az.length) / 2;
            for l[i] in root.az: Rectangle {
                y: rail.top-y + i * rail.step;
                height: rail.step;
                property <bool> on: gridbox.az-row == i || gridbox.scrub == i;
                Rectangle {
                    width: min(rail.step, rail.width) - 2px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: parent.on ? Theme.accent : transparent;
                }
                Text {
                    text: l.label;
                    color: parent.on ? Theme.accent-text : l.present ? Theme.secondary : Theme.tertiary;
                    opacity: l.present || parent.on ? 1 : 0.5;
                    font-size: Theme.tv ? 15px : 11px;
                    font-weight: 700;
                }
            }
            // Click a letter, or drag along the rail to scrub through the library.
            TouchArea {
                mouse-cursor: pointer;
                property <int> at: max(0, min(root.az.length - 1, floor((self.mouse-y - rail.top-y) / rail.step)));
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { gridbox.scrub = self.at; gridbox.jump(root.az[self.at].index, false); }
                    if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { gridbox.scrub = -1; }
                }
                moved => {
                    if (self.pressed && self.at != gridbox.scrub) { gridbox.scrub = self.at; gridbox.jump(root.az[self.at].index, false); }
                }
            }
        }
        // The letter, large, while scrubbing or on the rail with the remote.
        if gridbox.rail-w > 0 && (gridbox.scrub >= 0 || gridbox.az-row >= 0): Rectangle {
            property <int> l: gridbox.scrub >= 0 ? gridbox.scrub : gridbox.az-row;
            width: Theme.tv ? 120px : 88px;
            height: self.width;
            x: (gridbox.width - gridbox.rail-w - self.width) / 2;
            y: (gridbox.height - root.bottom-inset - self.height) / 2;
            border-radius: 20px;
            background: #000000b0;
            Text { text: parent.l >= 0 && parent.l < root.az.length ? root.az[parent.l].label : ""; color: white; font-size: Theme.tv ? 64px : 48px; font-weight: 700; }
        }
    }

    // Header strip, aligned with the window buttons; over the billboard on Home, and given a
    // background once the rows scroll up under it.
    Rectangle {
        x: root.content-x;
        y: 0;
        width: root.content-w;
        height: Theme.header-height;
        background: root.selected == -1 && root.home-top == 0 && !root.tv-home && shelf-view.content-y < -20px ? Theme.bg : transparent;
        animate background { duration: Theme.animate ? 150ms : 0ms; }
        HorizontalLayout {
            padding-left: root.pad;
            padding-right: 16px;
            Text {
                text: root.selected == -1 ? "Home" : root.grid-title;
                color: Theme.text;
                font-size: Theme.tv ? 18px : 15px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.loading: Text { text: "Loading…"; color: Theme.tertiary; font-size: 12px; vertical-alignment: center; }
            Rectangle { width: 12px; }
            if root.can-speed-test && root.selected >= 0 && !Theme.tv: VerticalLayout { alignment: center; IconButton { icon: "gauge"; size: 32px; icon-size: 16px; clicked => { root.speed-test(); } } }
            // Phones have no sidebar: Settings sits here instead.
            if root.compact: VerticalLayout { alignment: center; IconButton { icon: "settings"; size: 36px; icon-size: 17px; clicked => { root.settings(); } } }
        }
    }

    side := Sidebar {
        x: 0;
        visible: !root.compact;
        height: parent.height;
        libraries: root.libraries;
        selected: root.selected;
        search-text <=> root.search-text;
        select(i) => { root.select(i); }
        search(q) => { root.search(q); }
        settings => { root.settings(); }
    }
}

// ---------- Details ----------

component EpisodeRow inherits Rectangle {
    in property <Episode> data;
    in property <bool> focused;
    callback clicked();
    callback reveal(length, length);
    changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
    border-width: root.focused ? 3px : 0px;
    border-color: Theme.accent;
    height: 112px;
    border-radius: 12px;
    background: ta.has-hover ? Theme.fill-hover : Theme.fill;
    HorizontalLayout {
        padding: 10px;
        spacing: 16px;
        Rectangle {
            width: 164px;
            border-radius: 8px;
            clip: true;
            background: Theme.card;
            Image { width: parent.width; height: parent.height; source: root.data.image; image-fit: cover; opacity: root.data.watched ? 0.55 : 1; }
            if root.data.watched: Rectangle {
                x: parent.width - self.width - 6px;
                y: 6px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent;
                Icon { name: "check"; width: 14px; height: 14px; tint: Theme.accent-text; }
            }
            if root.data.progress > 0: Rectangle {
                y: parent.height - 4px;
                height: 4px;
                background: #00000070;
                Rectangle { x: 0; width: parent.width * root.data.progress; background: Theme.accent; }
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.data.label; color: Theme.accent; font-size: 13px; font-weight: 700; horizontal-stretch: 0; vertical-alignment: center; }
                Text { text: root.data.title; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: (root.data.watched ? "Watched" : root.data.progress > 0 ? "In progress" : "") + (root.data.runtime != "" && (root.data.watched || root.data.progress > 0) ? " · " : "") + root.data.runtime; color: root.data.watched ? Theme.accent : Theme.secondary; font-size: 12px; horizontal-stretch: 0; vertical-alignment: center; }
            }
            Text { text: root.data.summary; color: Theme.secondary; font-size: 13px; wrap: word-wrap; overflow: elide; height: 36px; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component RoundAction inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <string> tip;
    in property <bool> focused;
    callback clicked();
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: ta.has-hover || root.focused ? #ffffff2a : #ffffff17;
    border-width: root.focused ? 3px : 1px;
    border-color: root.focused ? Theme.accent : #ffffff14;
    Icon { name: root.icon; width: 20px; height: 20px; tint: root.active ? Theme.accent : Theme.text; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if (ta.has-hover || root.focused) && root.tip != "": Rectangle {
        y: parent.height + 6px;
        x: (parent.width - self.width) / 2;
        width: tiptext.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: #000000d0;
        tiptext := Text { text: root.tip; color: white; font-size: 11px; }
    }
}

component PersonCard inherits Rectangle {
    in property <Person> data;
    width: 92px;
    height: 150px;
    Rectangle {
        y: 0;
        width: 88px;
        height: 88px;
        x: 2px;
        border-radius: 14px;
        clip: true;
        background: Theme.card;
        Icon { name: "person"; width: 36px; height: 36px; tint: Theme.tertiary; visible: photo.source.width == 0; }
        photo := Image { width: parent.width; height: parent.height; source: root.data.image; image-fit: cover; }
    }
    Text { y: 96px; width: root.width; text: root.data.name; color: Theme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; overflow: elide; height: 34px; }
    Text { y: 131px; width: root.width; text: root.data.role; color: Theme.secondary; font-size: 12px; overflow: elide; }
}

component ScoreChip inherits HorizontalLayout {
    in property <Score> data;
    spacing: 6px;
    Rectangle {
        width: label.preferred-width + 10px;
        height: 20px;
        border-radius: 4px;
        background: root.data.tint;
        label := Text { text: root.data.source; color: #111; font-size: 10px; font-weight: 800; }
    }
    Text { text: root.data.value; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
}

component Detail inherits Rectangle {
    in property <Poster> item;
    in property <image> backdrop;
    in property <string> meta;
    in property <[string]> badges;          // "4K", "HDR10", "R"
    in property <string> summary;
    in property <string> summary-full;
    in property <string> tech;              // footer: codecs, size, bitrate
    in property <string> file-name;
    in property <string> play-label;
    // A title that isn't in the library: the main button is Seerr's Request, with its state.
    // play-progress is how far the download is (0 to 1; below 0, no bar); play-note a line under it.
    in property <string> play-icon: "play";
    in property <bool> play-enabled: true;
    in property <float> play-progress: -1;
    in property <string> play-note;
    in property <bool> can-restart;
    in property <bool> can-trailer;
    in property <bool> can-shuffle;          // albums and artists
    in property <bool> watched;
    in property <bool> can-mark-watched;
    in property <bool> can-favourite;
    in property <bool> favourite;
    // A catalogue title: the heart is the watchlist (+, then a tick).
    in property <bool> watchlist-mode;
    in property <bool> is-show;
    in property <[string]> seasons;
    in property <[bool]> seasons-watched;   // every episode of that season seen
    in property <int> selected-season;
    in property <[Episode]> episodes;
    in property <string> kind;            // movie, show, artist, album
    in property <[Poster]> albums;
    in property <[Track]> tracks;
    in property <[Person]> people;
    in property <[Score]> scores;
    in property <[Poster]> related;
    in property <length> bottom-inset;
    callback back();
    callback play();
    callback play-from-start();
    callback play-trailer();
    callback shuffle();
    callback toggle-watched();
    callback toggle-favourite();
    callback open(string);
    callback play-track(string);
    callback select-season(int);
    callback play-episode(string);
    background: Theme.bg;
    property <bool> expanded: false;
    property <bool> nav: Nav.active && Nav.zone == "detail";
    // Column of each action in the actions row (row 0), -1 when not shown.
    // Same order as detail_activate in lib.rs: Play, Shuffle, Trailer, From the beginning, Watched, Favourite.
    property <int> play-col: root.play-label != "" ? 0 : -1;
    property <int> n-play: root.play-label != "" ? 1 : 0;
    property <int> shuffle-col: root.can-shuffle ? root.n-play : -1;
    property <int> n-shuffle: root.can-shuffle ? 1 : 0;
    property <int> trailer-col: root.can-trailer ? root.n-play + root.n-shuffle : -1;
    property <int> n-trailer: root.can-trailer ? 1 : 0;
    property <int> n-before-restart: root.n-play + root.n-shuffle + root.n-trailer;
    property <int> restart-col: root.can-restart ? root.n-before-restart : -1;
    property <int> watched-col: root.can-mark-watched ? root.n-before-restart + (root.can-restart ? 1 : 0) : -1;
    property <int> favourite-col: root.can-favourite ? root.n-before-restart + (root.can-restart ? 1 : 0) + (root.can-mark-watched ? 1 : 0) : -1;
    // Albums and artists: cover beside the title, like a music app, instead of a film's backdrop.
    property <bool> music: root.kind == "album" || root.kind == "artist" || root.kind == "playlist";
    property <length> cover-size: root.compact ? 128px : Theme.tv ? 240px : 220px;
    function action-focused(c: int) -> bool { return root.nav && Nav.row == 0 && Nav.col == c && c >= 0; }
    // Scroll so a focused element (window coordinates) is fully visible; the first row scrolls to the top.
    function reveal(top: length, height: length) {
        if (top < scroller.absolute-position.y + Theme.header-height + 10px) {
            scroller.content-y = Math.min(0, scroller.content-y + (scroller.absolute-position.y + Theme.header-height + 10px - top));
        } else if (top + height > scroller.absolute-position.y + scroller.height - 10px - root.bottom-inset) {
            scroller.content-y = Math.max(scroller.height - scroller.content-height,
                scroller.content-y - (top + height - (scroller.absolute-position.y + scroller.height - 10px - root.bottom-inset)));
        }
    }
    property <int> nav-row: root.nav ? Nav.row : -1;
    changed nav-row => { if (self.nav-row == 0) { scroller.content-y = 0; } }
    property <bool> compact: root.width < 720px;
    property <length> pad: root.compact ? 16px : 40px;
    // Never taller than ~60% of the window, so Play stays visible on short (landscape phone) screens.
    property <length> hero-h: root.compact ? root.width * 0.62 : Math.min(root.height * 0.6, Math.max(380px, Math.min(root.height * 0.62, root.width * 0.5)));

    scroller := Flickable {
        content-height: body.preferred-height;
        body := VerticalLayout {
            padding-bottom: 40px + root.bottom-inset;
            if root.music: Rectangle {
                height: music-head.preferred-height;
                clip: true;
                Image { width: parent.width; height: parent.height; source: root.backdrop; image-fit: cover; opacity: 0.3; }
                Rectangle { background: @linear-gradient(180deg, #1c1c1e40 0%, Theme.bg 100%); }
                music-head := VerticalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad;
                    padding-top: Theme.header-height + (root.compact ? 8px : 28px);
                    padding-bottom: 8px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: root.compact ? 16px : 32px;
                        Rectangle {
                            width: root.cover-size;
                            height: root.cover-size;
                            border-radius: root.kind == "artist" ? root.cover-size / 2 : 10px;
                            clip: true;
                            background: Theme.card;
                            Icon { name: root.kind == "artist" ? "artist" : "music"; width: 40%; height: 40%; tint: Theme.tertiary; visible: cover-img.source.width == 0; }
                            cover-img := Image { width: parent.width; height: parent.height; source: root.item.image; image-fit: cover; }
                        }
                        VerticalLayout {
                            alignment: end;
                            spacing: 8px;
                            horizontal-stretch: 1;
                            Text { text: root.kind == "artist" ? "ARTIST" : root.kind == "playlist" ? "PLAYLIST" : "ALBUM"; color: Theme.secondary; font-size: 12px; font-weight: 700; }
                            Text { text: root.item.title; color: white; font-size: root.compact ? 24px : 40px; font-weight: 800; wrap: word-wrap; }
                            Text { text: root.meta; color: Theme.secondary; font-size: root.compact ? 13px : 15px; font-weight: 500; wrap: word-wrap; }
                            if !root.compact && root.summary != "": Text { text: root.summary; color: Theme.text; font-size: 14px; wrap: word-wrap; max-width: 760px; }
                            if !root.compact: HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                padding-top: 8px;
                                if root.play-label != "": Pill { text: root.play-label; icon: "play"; light: true; focused: root.action-focused(root.play-col); clicked => { root.play(); } }
                                if root.can-shuffle: Pill { text: "Shuffle"; icon: "shuffle"; light: root.action-focused(root.shuffle-col); focused: root.action-focused(root.shuffle-col); clicked => { root.shuffle(); } }
                                if root.can-favourite: VerticalLayout {
                                    alignment: center;
                                    RoundAction {
                                        icon: root.watchlist-mode ? (root.favourite ? "check" : "plus") : "heart";
                                        active: root.favourite;
                                        focused: root.action-focused(root.favourite-col);
                                        tip: root.watchlist-mode ? (root.favourite ? "Remove from Watchlist" : "Add to Watchlist") : root.favourite ? "Remove from Favourites" : "Add to Favourites";
                                        clicked => { root.toggle-favourite(); }
                                    }
                                }
                            }
                        }
                    }
                    // Phones: the buttons get their own row under the cover.
                    if root.compact: HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if root.play-label != "": Pill { text: root.play-label; icon: "play"; light: true; clicked => { root.play(); } }
                        if root.can-shuffle: Pill { text: "Shuffle"; icon: "shuffle"; clicked => { root.shuffle(); } }
                        if root.can-favourite: VerticalLayout { alignment: center; RoundAction { icon: root.watchlist-mode ? (root.favourite ? "check" : "plus") : "heart"; active: root.favourite; clicked => { root.toggle-favourite(); } } }
                    }
                }
            }
            // Hero: backdrop with the title over its bottom edge.
            if !root.music: Rectangle {
                height: root.hero-h;
                clip: true;
                Image { width: parent.width; height: parent.height; source: root.backdrop; image-fit: cover; }
                Rectangle { background: @linear-gradient(180deg, #00000070 0%, #00000000 22%, #1c1c1e00 55%, Theme.bg 100%); }
                Rectangle { background: @linear-gradient(90deg, #1c1c1ec0 0%, #1c1c1e00 60%); }
                Text {
                    x: root.pad;
                    y: parent.height - self.height - 18px;
                    width: Math.min(parent.width - 2 * root.pad, 900px);
                    text: root.item.title;
                    color: white;
                    font-size: root.compact ? 28px : 40px;
                    font-weight: 800;
                    wrap: word-wrap;
                }
            }
            // Actions on the left, information on the right.
            if !root.music: HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: 8px;
                spacing: root.compact ? 0 : 40px;
                if !root.compact: VerticalLayout {
                    width: 340px;
                    spacing: 16px;
                    alignment: start;
                    if root.play-label != "": Rectangle {
                        height: 52px;
                        border-radius: 26px;
                        background: !root.play-enabled ? #ffffff30 : pta.has-hover || root.action-focused(root.play-col) ? #ffffffe8 : #ffffffd6;
                        border-width: root.action-focused(root.play-col) ? 3px : 0px;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            VerticalLayout { alignment: center; Icon { name: root.play-icon; width: 16px; height: 16px; tint: root.play-enabled ? #111 : white; } }
                            Text { text: root.play-label; color: root.play-enabled ? #111 : white; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                        }
                        pta := TouchArea { mouse-cursor: root.play-enabled ? pointer : default; clicked => { root.play(); } }
                    }
                    if root.play-progress >= 0 || root.play-note != "": PlayStatus { progress: root.play-progress; note: root.play-note; }
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        if root.can-trailer: VerticalLayout {
                            alignment: center;
                            Pill { text: "Trailer"; icon: "film"; light: root.action-focused(root.trailer-col); focused: root.action-focused(root.trailer-col); clicked => { root.play-trailer(); } }
                        }
                        if root.can-restart: RoundAction { icon: "restart"; tip: "From the beginning"; focused: root.action-focused(root.restart-col); clicked => { root.play-from-start(); } }
                        if root.can-mark-watched: RoundAction {
                            icon: "eye";
                            active: root.watched;
                            focused: root.action-focused(root.watched-col);
                            tip: root.watched ? "Mark as unwatched" : "Mark as watched";
                            clicked => { root.toggle-watched(); }
                        }
                        if root.can-favourite: RoundAction {
                            icon: root.watchlist-mode ? (root.favourite ? "check" : "plus") : "heart";
                            active: root.favourite;
                            focused: root.action-focused(root.favourite-col);
                            tip: root.watchlist-mode ? (root.favourite ? "Remove from Watchlist" : "Add to Watchlist") : root.favourite ? "Remove from Favourites" : "Add to Favourites";
                            clicked => { root.toggle-favourite(); }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    horizontal-stretch: 1;
                    // Compact: Play and the round actions sit above the information.
                    if root.compact: HorizontalLayout {
                        spacing: 10px;
                        padding-bottom: 6px;
                        if root.play-label != "": Rectangle {
                            horizontal-stretch: 1;
                            height: 46px;
                            border-radius: 23px;
                            background: !root.play-enabled ? #ffffff30 : cpta.has-hover ? #ffffffe8 : #ffffffd6;
                            border-width: root.action-focused(root.play-col) ? 3px : 0px;
                            border-color: Theme.accent;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                VerticalLayout { alignment: center; Icon { name: root.play-icon; width: 14px; height: 14px; tint: root.play-enabled ? #111 : white; } }
                                Text { text: root.play-label; color: root.play-enabled ? #111 : white; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                            }
                            cpta := TouchArea { clicked => { root.play(); } }
                        }
                        if root.can-restart: RoundAction { icon: "restart"; clicked => { root.play-from-start(); } }
                        if root.can-mark-watched: RoundAction { icon: "eye"; active: root.watched; clicked => { root.toggle-watched(); } }
                        if root.can-favourite: RoundAction { icon: root.watchlist-mode ? (root.favourite ? "check" : "plus") : "heart"; active: root.favourite; clicked => { root.toggle-favourite(); } }
                    }
                    if root.compact && (root.play-progress >= 0 || root.play-note != ""): PlayStatus { progress: root.play-progress; note: root.play-note; }
                    // Spelled out: an icon alone doesn't say "trailer".
                    if root.compact && root.can-trailer: HorizontalLayout {
                        alignment: start;
                        padding-bottom: 6px;
                        Pill { text: "Trailer"; icon: "film"; clicked => { root.play-trailer(); } }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        Text { text: root.meta; wrap: word-wrap; color: Theme.secondary; font-size: 15px; font-weight: 500; vertical-alignment: center; }
                        for badge in root.badges: Rectangle {
                            width: btext.preferred-width + 12px;
                            height: 22px;
                            border-radius: 4px;
                            border-width: 1.5px;
                            border-color: Theme.secondary;
                            btext := Text { text: badge; color: Theme.secondary; font-size: 12px; font-weight: 700; }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            max-width: 760px;
                            text: root.expanded ? root.summary-full : root.summary;
                            color: Theme.text;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                    }
                    if root.summary-full != root.summary && !root.expanded: HorizontalLayout {
                        alignment: start;
                        LinkText { text: "MORE"; font-size: 12px; clicked => { root.expanded = true; } }
                    }
                    if root.scores.length > 0: HorizontalLayout {
                        spacing: 22px;
                        alignment: start;
                        padding-top: 4px;
                        for sc in root.scores: ScoreChip { data: sc; }
                    }
                }
            }
            // Seasons and episodes.
            if root.is-show: VerticalLayout {
                spacing: 14px;
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: 36px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for s[i] in root.seasons: Button {
                        text: s;
                        icon: root.seasons-watched[i] ? "check" : "";
                        primary: i == root.selected-season;
                        focused: root.nav && Nav.d-seasons >= 0 && Nav.row == Nav.d-seasons && Nav.col == i;
                        clicked => { root.select-season(i); }
                    }
                }
                for ep[ei] in root.episodes: EpisodeRow {
                    data: ep;
                    focused: root.nav && Nav.d-episodes >= 0 && Nav.row == Nav.d-episodes + ei;
                    reveal(t, hh) => { root.reveal(t, hh); }
                    clicked => { root.play-episode(ep.id); }
                }
            }
            if root.kind == "artist": VerticalLayout {
                padding-left: root.pad - 12px;   // the shelf keeps 12px for the focused card
                padding-top: 24px;
                Shelf {
                    title: "Albums"; items: root.albums; square: true;
                    focused-index: root.nav && Nav.d-albums >= 0 && Nav.row == Nav.d-albums ? Nav.col : -1;
                    open(id) => { root.open(id); }
                    reveal(t, hh) => { root.reveal(t, hh); }
                }
            }
            if root.kind == "album" || root.kind == "playlist": VerticalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: 24px;
                max-width: 940px;
                for t[ti] in root.tracks: TrackRow {
                    data: t;
                    focused: root.nav && Nav.d-tracks >= 0 && Nav.row == Nav.d-tracks + ti;
                    reveal(t2, hh) => { root.reveal(t2, hh); }
                    clicked => { root.play-track(t.id); }
                }
            }
            if root.people.length > 0: VerticalLayout {
                padding-left: root.pad;
                padding-top: 40px;
                spacing: 14px;
                Text { text: "Cast and Crew"; color: Theme.text; font-size: 20px; font-weight: 700; }
                Flickable {
                    height: 152px;
                    content-width: root.people.length * 110px;
                    for person[i] in root.people: PersonCard { x: i * 110px; data: person; }
                }
            }
            if root.related.length > 0: VerticalLayout {
                padding-left: root.pad - 12px;   // the shelf keeps 12px for the focused card
                padding-top: 36px;
                Shelf {
                    title: "More Like This"; items: root.related; square: root.kind == "artist" || root.kind == "album";
                    focused-index: root.nav && Nav.d-related >= 0 && Nav.row == Nav.d-related ? Nav.col : -1;
                    open(id) => { root.open(id); }
                    reveal(t, hh) => { root.reveal(t, hh); }
                }
            }
            if root.file-name != "": HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: 32px;
                spacing: 24px;
                Text { text: root.file-name; color: Theme.tertiary; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                Text { text: root.tech; color: Theme.tertiary; font-size: 12px; horizontal-alignment: right; }
            }
        }
    }

    // Header strip: back and title, right of the window buttons. Gets a background once the
    // page scrolls, so content doesn't run under it.
    Rectangle {
        y: 0;
        height: Theme.header-height;
        background: Theme.bg.with-alpha(0.94);
        opacity: Math.max(0, Math.min(1, -scroller.content-y / (root.hero-h * 0.6)));
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
    }
    HorizontalLayout {
        x: Theme.buttons-inset;
        y: (Theme.header-height - 30px) / 2;
        height: 30px;
        width: root.width - 100px;
        spacing: 12px;
        IconButton { icon: "back"; size: 30px; icon-size: 15px; clicked => { root.back(); } }
        Text { text: root.item.title; color: white; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; }
    }
}

// ---------- Now playing (music) ----------

// Now Playing: the cover, where the song is, the controls, and what's next (or the words). Remote
// focus is zone "np": row 0 the controls (Previous, Play/Pause, Next, Repeat, Lyrics), then one row
// per queued song, or per line of synced lyrics.
component NpPanel inherits VerticalLayout {
    in property <string> title;
    in property <string> artist;
    in property <image> art;
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text;
    in property <string> duration-text;
    in property <int> repeat;
    in property <length> cover-size;
    in property <int> focus-col: -1;
    in property <bool> lyrics-open;
    callback toggle();
    callback next();
    callback prev();
    callback repeat-clicked();
    callback seek-to(float);
    callback lyrics();
    spacing: 18px;
    alignment: start;
    if root.cover-size > 0: HorizontalLayout {
        alignment: center;
        Rectangle {
            width: root.cover-size;
            height: root.cover-size;
            border-radius: 14px;
            clip: true;
            background: Theme.card;
            drop-shadow-blur: 40px;
            drop-shadow-color: #00000090;
            Icon { name: "music"; width: 30%; height: 30%; tint: Theme.tertiary; visible: np-cover.source.width == 0; }
            np-cover := Image { width: parent.width; height: parent.height; source: root.art; image-fit: cover; }
        }
    }
    VerticalLayout {
        spacing: 4px;
        Text { text: root.title; color: Theme.text; font-size: 24px; font-weight: 700; overflow: elide; horizontal-alignment: center; }
        Text { text: root.artist; color: Theme.secondary; font-size: 15px; overflow: elide; horizontal-alignment: center; }
    }
    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: #ffffff22;
            Rectangle {
                x: 0;
                width: root.duration > 0 ? parent.width * min(1, root.position / root.duration) : 0;
                border-radius: 3px;
                background: Theme.accent;
            }
            TouchArea {
                y: -8px;
                height: parent.height + 16px;
                mouse-cursor: pointer;
                clicked => { if (root.duration > 0) { root.seek-to(max(0, min(1, self.mouse-x / self.width)) * root.duration); } }
            }
        }
        HorizontalLayout {
            Text { text: root.position-text; color: Theme.secondary; font-size: 12px; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.duration-text; color: Theme.secondary; font-size: 12px; }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: root.width < 380px ? 8px : 18px;
        VerticalLayout { alignment: center; IconButton { icon: "prev"; size: 48px; icon-size: 20px; focused: root.focus-col == 0; clicked => { root.prev(); } } }
        VerticalLayout { alignment: center; IconButton { icon: root.paused ? "play" : "pause"; primary: true; size: 68px; icon-size: 28px; focused: root.focus-col == 1; clicked => { root.toggle(); } } }
        VerticalLayout { alignment: center; IconButton { icon: "next"; size: 48px; icon-size: 20px; focused: root.focus-col == 2; clicked => { root.next(); } } }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: root.repeat == 2 ? "repeat-one" : "repeat";
                active: root.repeat > 0;
                size: 48px;
                icon-size: 20px;
                focused: root.focus-col == 3;
                clicked => { root.repeat-clicked(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton { icon: "lyrics"; active: root.lyrics-open; size: 48px; icon-size: 20px; focused: root.focus-col == 4; clicked => { root.lyrics(); } }
        }
    }
}

// The song's words. Synced: the line being sung is lit and kept a third of the way down, what's
// been sung fades; clicking a line (OK on the remote) jumps there. Scrolling by hand pauses the
// following for a few seconds. Plain: just the words.
component NpLyrics inherits Rectangle {
    in property <[LyricLine]> lines;
    in property <int> current: -1;
    in property <string> state;           // "loading", "none", "plain", "synced"
    in property <string> credit;
    in property <int> focus-row: -1;      // remote: a line
    callback seek-to(float);
    property <bool> synced: root.state == "synced";
    in property <bool> narrow;            // phones
    in property <length> area;            // about how tall the view is (set from outside: no loop)
    property <length> font: Theme.tv ? 34px : root.narrow ? 22px : 28px;
    property <bool> held;                 // scrolled by hand: don't follow for now
    // Puts a line (top `y`, height `h`) a third of the way down.
    function show(y: length, h: length) {
        view.content-y = Math.max(Math.min(0, view.height - view.content-height), Math.min(0, view.height * 0.32 - y - h / 2));
    }
    property <length> now-y;              // where the line being sung is
    property <length> now-h;
    function follow(y: length, h: length) {
        root.now-y = y;
        root.now-h = h;
        if (!root.held && root.focus-row < 0) { root.show(y, h); }
    }
    clip: true;
    if root.state == "loading" || root.state == "none": Text {
        text: root.state == "loading" ? "Finding the words…" : "No lyrics for this song.";
        color: Theme.secondary;
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    view := Flickable {
        visible: root.state == "plain" || root.state == "synced";
        content-height: body.preferred-height;
        animate content-y { duration: root.held || !Theme.animate ? 0ms : 450ms; easing: ease-out; }
        flicked => {
            root.held = true;
            resume.running = false;
            resume.running = true;
        }
        body := VerticalLayout {
            width: view.width;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: root.synced ? root.area * 0.3 : 8px;
            padding-bottom: root.synced ? root.area * 0.6 : 32px;
            spacing: root.font * 0.5;
            if !root.synced: Text {
                text: "These lyrics aren't synced to the song.";
                color: Theme.tertiary;
                font-size: 13px;
            }
            for line[i] in root.lines: Text {
                property <bool> now: root.synced && i == root.current;
                property <bool> sung: root.synced && i < root.current;
                property <bool> focused: root.focus-row == i;
                text: line.text == "" && root.synced ? "♪" : line.text;
                wrap: word-wrap;
                font-size: root.synced ? root.font : root.font * 0.8;
                font-weight: 700;
                color: self.now || !root.synced ? Theme.text : self.sung ? Theme.text.with-alpha(0.32) : Theme.text.with-alpha(0.55);
                animate color { duration: Theme.animate ? 300ms : 0ms; }
                init => { if (self.now) { root.follow(self.y, self.height); } }
                changed now => { if (self.now) { root.follow(self.y, self.height); } }
                changed focused => { if (self.focused) { root.show(self.y, self.height); } }
                Rectangle {
                    x: -10px;
                    y: -6px;
                    width: parent.width + 20px;
                    height: parent.height + 12px;
                    border-radius: 10px;
                    border-width: parent.focused ? 3px : 0px;
                    border-color: Theme.accent;
                }
                TouchArea {
                    enabled: root.synced;
                    mouse-cursor: root.synced ? pointer : default;
                    clicked => { root.seek-to(line.time); }
                }
            }
            if root.credit != "": Text {
                text: root.credit;
                color: Theme.tertiary;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
    resume := Timer {
        interval: 4s;
        running: false;
        triggered => {
            self.running = false;
            root.held = false;
            // Back to the line being sung.
            if (root.current >= 0 && root.focus-row < 0) { root.show(root.now-y, root.now-h); }
        }
    }
}

component NpQueue inherits VerticalLayout {
    in property <[Track]> queue;
    in property <int> focus-row: -1;      // index in the queue
    in property <int> current: -1;        // the song playing
    callback jump(string);
    // Opened, or the song changed: the song playing near the top.
    function show-current() {
        if (self.current >= 0) {
            queue-view.content-y = Math.max(Math.min(0, queue-view.height - queue-view.content-height), -Math.max(0, self.current - 1) * 46px);
        }
    }
    init => { self.show-current(); }
    changed current => { self.show-current(); }
    spacing: 10px;
    Text { text: "Up Next"; color: Theme.text; font-size: 20px; font-weight: 700; }
    queue-view := Flickable {
        vertical-stretch: 1;
        content-height: root.queue.length * 46px + 24px;
        for t[i] in root.queue: TrackRow {
            y: i * 46px;
            width: parent.width;
            data: t;
            focused: root.focus-row == i;
            clicked => { root.jump(t.id); }
        }
    }
    // Keep the focused song in view.
    changed focus-row => {
        if (self.focus-row >= 0) {
            if (self.focus-row * 46px < -queue-view.content-y) {
                queue-view.content-y = -(self.focus-row * 46px);
            } else if ((self.focus-row + 1) * 46px > -queue-view.content-y + queue-view.height) {
                queue-view.content-y = -((self.focus-row + 1) * 46px - queue-view.height);
            }
        }
    }
}

component NowPlaying inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <image> art;
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text;
    in property <string> duration-text;
    in property <int> repeat;
    in property <[Track]> queue;
    in property <int> current;
    in property <length> inset-top;
    in property <length> inset-bottom;
    in property <bool> lyrics-open;
    in property <[LyricLine]> lyrics;
    in property <int> lyric-index;
    in property <string> lyrics-state;
    in property <string> lyrics-credit;
    callback toggle();
    callback next();
    callback prev();
    callback repeat-clicked();
    callback seek-to(float);
    callback jump(string);
    callback close();
    callback lyrics-clicked();
    property <bool> nav: Nav.active && Nav.zone == "np";
    property <int> focus-col: root.nav && Nav.row == 0 ? Nav.col : -1;
    property <int> focus-row: root.nav && Nav.row > 0 ? Nav.row - 1 : -1;
    property <bool> wide: root.width >= 900px;
    property <length> top: root.inset-top + 64px;
    background: Theme.bg;
    // Swallow clicks meant for the page underneath.
    TouchArea { }
    Image { width: 100%; height: 100%; source: root.art; image-fit: cover; opacity: 0.16; }
    Rectangle { background: @linear-gradient(180deg, #00000030 0%, Theme.bg 80%); }
    IconButton { x: 16px; y: root.inset-top + 14px; icon: "back"; size: 36px; icon-size: 15px; clicked => { root.close(); } }
    Text { x: 64px; y: root.inset-top + 20px; text: "Now Playing"; color: Theme.text; font-size: 17px; font-weight: 700; }

    if root.wide: HorizontalLayout {
        y: root.top;
        height: root.height - root.top - root.inset-bottom;
        padding-left: 56px;
        padding-right: 56px;
        padding-bottom: 32px;
        spacing: 64px;
        NpPanel {
            width: min(440px, root.width * 0.4);
            cover-size: min(400px, root.width * 0.4, root.height - root.top - 260px);
            title: root.title; artist: root.artist; art: root.art; paused: root.paused;
            position: root.position; duration: root.duration;
            position-text: root.position-text; duration-text: root.duration-text;
            repeat: root.repeat; focus-col: root.focus-col; lyrics-open: root.lyrics-open;
            toggle => { root.toggle(); } next => { root.next(); } prev => { root.prev(); }
            repeat-clicked => { root.repeat-clicked(); } seek-to(t) => { root.seek-to(t); }
            lyrics => { root.lyrics-clicked(); }
        }
        if !root.lyrics-open: NpQueue { horizontal-stretch: 1; queue: root.queue; current: root.current; focus-row: root.focus-row; jump(id) => { root.jump(id); } }
        if root.lyrics-open: NpLyrics {
            horizontal-stretch: 1;
            narrow: false;
            area: root.height - root.top - root.inset-bottom;
            lines: root.lyrics; current: root.lyric-index; state: root.lyrics-state; credit: root.lyrics-credit;
            focus-row: root.focus-row;
            seek-to(t) => { root.seek-to(t); }
        }
    }
    if !root.wide: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.inset-bottom;
        padding-left: 24px;
        padding-right: 24px;
        padding-bottom: 16px;
        spacing: 24px;
        NpPanel {
            // The words need the room: the cover steps aside.
            cover-size: root.lyrics-open ? 0 : min(root.width - 96px, 280px, root.height * 0.32);
            title: root.title; artist: root.artist; art: root.art; paused: root.paused;
            position: root.position; duration: root.duration;
            position-text: root.position-text; duration-text: root.duration-text;
            repeat: root.repeat; focus-col: root.focus-col; lyrics-open: root.lyrics-open;
            toggle => { root.toggle(); } next => { root.next(); } prev => { root.prev(); }
            repeat-clicked => { root.repeat-clicked(); } seek-to(t) => { root.seek-to(t); }
            lyrics => { root.lyrics-clicked(); }
        }
        if !root.lyrics-open: NpQueue { vertical-stretch: 1; queue: root.queue; current: root.current; focus-row: root.focus-row; jump(id) => { root.jump(id); } }
        if root.lyrics-open: NpLyrics {
            vertical-stretch: 1;
            narrow: true;
            area: root.height * 0.5;
            lines: root.lyrics; current: root.lyric-index; state: root.lyrics-state; credit: root.lyrics-credit;
            focus-row: root.focus-row;
            seek-to(t) => { root.seek-to(t); }
        }
    }
}

component MiniPlayer inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <image> art;
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text;
    in property <string> duration-text;
    in property <int> repeat;              // 0 off, 1 the whole queue, 2 this track
    in property <int> focus-col: -1;       // remote focus, see music_nav in lib.rs
    callback toggle();
    callback next();
    callback prev();
    callback close();
    callback repeat-clicked();
    callback seek-to(float);
    callback expand();
    // Phones: cover and title, play/pause, next and close; the rest is in Now Playing.
    property <bool> compact: root.width < 620px;
    height: root.compact ? 64px : 76px;
    border-radius: 14px;
    background: #2c2c2ef2;
    border-width: 1px;
    border-color: Theme.separator;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;
    clip: true;
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: #ffffff14;
        Rectangle { x: 0; width: root.duration > 0 ? parent.width * min(1, root.position / root.duration) : 0; background: Theme.accent; }
    }
    TouchArea {
        y: parent.height - 10px;
        height: 10px;
        mouse-cursor: pointer;
        clicked => { if (root.duration > 0) { root.seek-to(max(0, min(1, self.mouse-x / self.width)) * root.duration); } }
    }
    HorizontalLayout {
        padding: root.compact ? 8px : 12px;
        padding-right: root.compact ? 10px : 16px;
        spacing: root.compact ? 8px : 14px;
        Rectangle {
            // Fixed on wide screens; on phones it takes what the buttons leave.
            min-width: root.compact ? 0px : 306px;
            max-width: root.compact ? 2000px : 306px;
            horizontal-stretch: root.compact ? 1 : 0;
            border-radius: 8px;
            border-width: root.focus-col == 0 ? 3px : 0px;
            border-color: white;
            background: info-ta.has-hover || root.focus-col == 0 ? #ffffff10 : transparent;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: root.compact ? 46px : 52px;
                    border-radius: 6px;
                    clip: true;
                    background: Theme.card;
                    Image { width: parent.width; height: parent.height; source: root.art; image-fit: cover; }
                }
                VerticalLayout {
                    alignment: center;
                    min-width: 0;
                    horizontal-stretch: 1;
                    Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                    Text { text: root.artist; color: Theme.secondary; font-size: 12px; overflow: elide; }
                }
            }
            info-ta := TouchArea { mouse-cursor: pointer; clicked => { root.expand(); } }
        }
        if !root.compact: Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            alignment: center;
            spacing: root.compact ? 4px : 10px;
            if !root.compact: VerticalLayout { alignment: center; IconButton { icon: "prev"; focused: root.focus-col == 1; clicked => { root.prev(); } } }
            VerticalLayout { alignment: center; IconButton { icon: root.paused ? "play" : "pause"; primary: true; size: root.compact ? 40px : 44px; focused: root.focus-col == 2; clicked => { root.toggle(); } } }
            VerticalLayout { alignment: center; IconButton { icon: "next"; focused: root.focus-col == 3; clicked => { root.next(); } } }
            if !root.compact: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.repeat == 2 ? "repeat-one" : "repeat";
                    active: root.repeat > 0;
                    focused: root.focus-col == 4;
                    clicked => { root.repeat-clicked(); }
                }
            }
        }
        if !root.compact: Rectangle { horizontal-stretch: 1; }
        if !root.compact: Text { text: root.position-text + " / " + root.duration-text; color: Theme.secondary; font-size: 12px; vertical-alignment: center; }
        VerticalLayout { alignment: center; IconButton { icon: "close"; size: 28px; icon-size: 12px; focused: root.focus-col == 5; clicked => { root.close(); } } }
    }
}

// ---------- Video player ----------

// Transparent round button for the control bar.
component BarButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 20px;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> focused;     // TV remote
    callback clicked();
    width: Theme.tv ? 50px : 34px;
    height: self.width;
    border-radius: self.width / 2;
    background: root.focused ? white : ta.has-hover && root.enabled ? #ffffff1c : root.active ? #ffffff14 : transparent;
    opacity: root.enabled || root.focused ? 1 : 0.35;
    Icon {
        name: root.icon;
        width: root.icon-size * (Theme.tv ? 1.3 : 1);
        height: self.width;
        stroke: 2px;
        tint: root.focused ? black : root.active ? Theme.accent : white;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); PlayerState.poke(); }
    }
}

// A thin track with a round knob; click or drag to change. `value` is 0..1.
component Slider inherits Rectangle {
    in property <float> value;
    in property <bool> focused;     // TV remote: thicker, with a larger knob
    callback changing(float);   // while dragging
    callback changed(float);    // on release / click
    height: 20px;
    property <float> shown: ta.pressed ? Math.max(0, Math.min(1, ta.mouse-x / self.width)) : root.value;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.focused ? 8px : 5px;
        border-radius: self.height / 2;
        background: #ffffff38;
        Rectangle { x: 0; width: parent.width * root.shown; border-radius: 2.5px; background: white; }
    }
    Rectangle {
        x: parent.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: root.focused ? 22px : ta.pressed || ta.has-hover ? 16px : 13px;
        height: self.width;
        border-radius: self.width / 2;
        background: white;
        border-width: root.focused ? 3px : 0px;
        border-color: Theme.accent;
        drop-shadow-blur: PlayerState.window-modes ? 4px : 0px;
        drop-shadow-color: #00000080;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.changing(Math.max(0, Math.min(1, self.mouse-x / self.width)));
                PlayerState.poke();
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.changed(Math.max(0, Math.min(1, self.mouse-x / self.width)));
            }
        }
    }
}

component PanelRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked;
    in property <bool> focused;     // TV remote
    callback clicked();
    callback reveal(length, length);
    changed focused => { if (self.focused) { root.reveal(self.y, self.height); } }
    height: (root.detail == "" ? 34px : 46px) * (Theme.tv ? 1.25 : 1);
    border-radius: 7px;
    border-width: root.focused ? 2px : 0px;
    border-color: white;
    background: root.focused ? #ffffff24 : ta.has-hover ? #ffffff14 : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            width: 18px;
            if root.checked: Icon { name: "check"; width: 14px; height: 14px; tint: Theme.accent; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.text; color: white; font-size: Theme.tv ? 16px : 13px; font-weight: root.checked ? 600 : 400; overflow: elide; }
            if root.detail != "": Text { text: root.detail; color: #ffffff90; font-size: Theme.tv ? 14px : 12px; overflow: elide; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component PanelHeading inherits Text {
    color: #ffffff80;
    font-size: 11px;
    font-weight: 700;
    height: 26px;
    vertical-alignment: bottom;
}

// "−  0.3 s  +" for delays.
component Stepper inherits HorizontalLayout {
    in property <string> label;
    in property <float> value;
    in property <int> focused-col: -1;     // TV remote: 0 minus, 1 plus
    callback nudge(float);
    spacing: 6px;
    padding-top: 2px;
    Text { text: root.label; color: white; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
    for d[i] in [-0.1, 0.1]: Rectangle {
        width: 30px;
        height: 28px;
        border-radius: 7px;
        border-width: root.focused-col == i ? 2px : 0px;
        border-color: white;
        background: sa.has-hover ? #ffffff1c : #ffffff10;
        Text { text: d < 0 ? "−" : "+"; color: white; font-size: 15px; font-weight: 700; }
        sa := TouchArea { mouse-cursor: pointer; clicked => { root.nudge(d); } }
    }
    Text {
        width: 64px;
        text: (root.value >= 0 ? "+" : "") + Math.round(root.value * 10) / 10 + " s";
        color: Math.abs(root.value) < 0.05 ? #ffffff90 : Theme.accent;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component Player inherits Rectangle {
    // Phones: status bar and gesture bar; the video may run under them, the controls may not.
    in property <length> inset-top;
    in property <length> inset-bottom;
    // The video is drawn by mpv underneath; this only adds the controls.
    background: transparent;

    // Slint's `moved` only fires while a button is held, so watch the pointer position instead.
    TouchArea {
        mouse-cursor: PlayerState.controls-visible ? default : none;
        // Desktop only: on touchscreens a tap also "moves" the pointer.
        changed mouse-x => { if (PlayerState.window-modes) { PlayerState.poke(); } }
        changed mouse-y => { if (PlayerState.window-modes) { PlayerState.poke(); } }
        clicked => {
            if (PlayerState.panel != "") {
                PlayerState.open-panel("");
            } else if (PlayerState.window-modes) {
                PlayerState.toggle-pause();           // desktop: click pauses
            } else {
                PlayerState.toggle-controls();        // touch: tap shows/hides the controls
            }
        }
        double-clicked => { PlayerState.toggle-fullscreen(); }
    }

    if PlayerState.buffering: Text { text: "Loading…"; color: #ffffffc0; font-size: 16px; }

    // HDR straight to the TV: mpv can't draw subtitles on that layer, so they're drawn here.
    if PlayerState.direct && PlayerState.direct-sub != "": Text {
        x: root.width * 0.1;
        width: root.width * 0.8;
        y: root.height - root.inset-bottom - self.height - root.height * 0.06
            - (PlayerState.controls-visible ? 120px : 0px);
        text: PlayerState.direct-sub;
        horizontal-alignment: center;
        wrap: word-wrap;
        color: white;
        font-size: Math.max(18px, root.height * 0.045) * PlayerState.sub-scale;
        font-weight: 600;
        stroke: black;
        stroke-width: 2.5px;
        stroke-style: outside;
    }

    // Top: back and title.
    if PlayerState.controls-visible: Rectangle {
        y: 0;
        height: 110px;
        background: @linear-gradient(180deg, #000000a0 0%, #00000000 100%);
        HorizontalLayout {
            padding-left: PlayerState.fullscreen ? 20px : Theme.buttons-inset;
            padding-top: 11px + root.inset-top;
            spacing: 12px;
            alignment: start;
            VerticalLayout { alignment: start; BarButton { icon: "back"; icon-size: 16px; clicked => { PlayerState.stop(); } } }
            if !PlayerState.pip: VerticalLayout {
                alignment: start;
                padding-top: 2px;
                Text { text: PlayerState.title; color: white; font-size: 15px; font-weight: 700; }
                Text { text: PlayerState.subtitle; color: #ffffffa8; font-size: 12px; }
            }
        }
    }

    // Floating control bar.
    // TV remote: what the focused button does, above the bar.
    property <[string]> button-names: [
        "Previous", "Back 10 seconds", PlayerState.paused ? "Play" : "Pause", "Forward 30 seconds", "Next",
        "Audio and subtitles", PlayerState.list-title == "EPISODES" ? "Episodes" : "Chapters"];
    if Theme.tv && PlayerState.controls-visible && PlayerState.focus-row == 1 && PlayerState.panel == "": Text {
        y: root.height - 130px - 28px - root.inset-bottom - 34px;
        x: (root.width - self.width) / 2;
        text: root.button-names[PlayerState.focus-col];
        color: white;
        font-size: 16px;
        font-weight: 600;
    }

    if PlayerState.controls-visible: bar := Rectangle {
        property <bool> compact: root.width < 620px && !Theme.tv;
        property <bool> remote: Theme.tv && PlayerState.panel == "";
        width: Theme.tv ? Math.min(900px, root.width - 64px) : Math.min(660px, root.width - 32px);
        height: Theme.tv ? 130px : compact ? 84px : 92px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (compact ? 12px : 28px) - root.inset-bottom;
        border-radius: 18px;
        background: #1f1f21e8;
        border-width: 1px;
        border-color: #ffffff1c;
        drop-shadow-blur: PlayerState.window-modes ? 30px : 0px;
        drop-shadow-color: #00000090;
        // Swallow clicks so they don't pause the video underneath.
        TouchArea { changed mouse-x => { PlayerState.poke(); } }
        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 10px;
            padding-bottom: 12px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 4px;
                // Volume (a TV remote has its own volume buttons)
                if !compact && !Theme.tv: HorizontalLayout {
                    width: 160px;
                    spacing: 6px;
                    BarButton { icon: PlayerState.muted || PlayerState.volume == 0 ? "mute" : "volume"; clicked => { PlayerState.toggle-mute(); } }
                    VerticalLayout {
                        alignment: center;
                        Slider {
                            value: PlayerState.muted ? 0 : PlayerState.volume;
                            changing(v) => { PlayerState.set-volume(v); }
                            changed(v) => { PlayerState.set-volume(v); }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Transport
                BarButton { icon: "prev"; icon-size: 18px; enabled: PlayerState.has-prev; focused: remote && PlayerState.focus-row == 1 && PlayerState.focus-col == 0; clicked => { PlayerState.prev(); } }
                BarButton { icon: "replay"; focused: remote && PlayerState.focus-row == 1 && PlayerState.focus-col == 1; clicked => { PlayerState.seek-by(-10); } }
                BarButton { icon: PlayerState.paused ? "play" : "pause"; icon-size: 24px; width: Theme.tv ? 58px : 44px; focused: remote && PlayerState.focus-row == 1 && PlayerState.focus-col == 2; clicked => { PlayerState.toggle-pause(); } }
                BarButton { icon: "forward"; focused: remote && PlayerState.focus-row == 1 && PlayerState.focus-col == 3; clicked => { PlayerState.seek-by(30); } }
                BarButton { icon: "next"; icon-size: 18px; enabled: PlayerState.has-next; focused: remote && PlayerState.focus-row == 1 && PlayerState.focus-col == 4; clicked => { PlayerState.next(); } }
                Rectangle { horizontal-stretch: 1; }
                // Options
                HorizontalLayout {
                    width: compact ? 120px : 160px;
                    alignment: end;
                    spacing: 4px;
                    BarButton { icon: "settings"; active: PlayerState.panel == "settings"; focused: remote && PlayerState.focus-row == 1 && PlayerState.focus-col == 5; clicked => { PlayerState.open-panel(PlayerState.panel == "settings" ? "" : "settings"); } }
                    if PlayerState.window-modes && !Theme.tv: BarButton { icon: "pip"; active: PlayerState.pip; clicked => { PlayerState.toggle-pip(); } }
                    if !PlayerState.pip && PlayerState.window-modes && !Theme.tv: BarButton { icon: PlayerState.fullscreen ? "exit-fullscreen" : "fullscreen"; clicked => { PlayerState.toggle-fullscreen(); } }
                    BarButton { icon: "list"; active: PlayerState.panel == "list"; focused: remote && PlayerState.focus-row == 1 && PlayerState.focus-col == 6; clicked => { PlayerState.open-panel(PlayerState.panel == "list" ? "" : "list"); } }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                Text { text: PlayerState.position-text; color: white; font-size: Theme.tv ? 16px : 12px; font-weight: 600; vertical-alignment: center; width: Theme.tv ? 70px : 52px; }
                Slider {
                    focused: remote && PlayerState.focus-row == 0;
                    value: PlayerState.duration > 0 ? PlayerState.position / PlayerState.duration : 0;
                    changing(v) => { PlayerState.scrub-to(v * PlayerState.duration); }
                    changed(v) => { PlayerState.seek-to(v * PlayerState.duration); }
                }
                Text { text: PlayerState.remaining-text; color: white; font-size: Theme.tv ? 16px : 12px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; width: Theme.tv ? 80px : 60px; }
            }
        }
    }

    // Settings: audio, subtitles, speed.
    if PlayerState.panel == "settings": spanel := Rectangle {
        // TV remote: scroll the focused row into view.
        function reveal(y: length, h: length) {
            if (y < -sflick.content-y) {
                sflick.content-y = -y;
            } else if (y + h > -sflick.content-y + sflick.height) {
                sflick.content-y = -(y + h - sflick.height);
            }
        }
        property <bool> remote: Theme.tv;
        width: Theme.tv ? 420px : 320px;
        height: Math.min(root.height - (Theme.tv ? 100px : 160px), inner.preferred-height + 20px);
        x: root.width - self.width - Math.max(16px, (root.width - Math.min(660px, root.width - 32px)) / 2);
        y: Theme.tv ? 40px : root.height - self.height - 132px;
        border-radius: 14px;
        background: #1f1f21f2;
        border-width: 1px;
        border-color: #ffffff1c;
        drop-shadow-blur: PlayerState.window-modes ? 30px : 0px;
        drop-shadow-color: #00000090;
        TouchArea { }
        sflick := Flickable {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            content-height: inner.preferred-height;
            inner := VerticalLayout {
                PanelHeading { text: "AUDIO"; }
                for t[i] in PlayerState.audio-tracks: PanelRow {
                    text: t.label;
                    checked: t.selected;
                    focused: spanel.remote && PlayerState.panel-row == i;
                    reveal(y, h) => { spanel.reveal(y, h); }
                    clicked => { PlayerState.select-audio(t.id); }
                }
                PanelHeading { text: "SUBTITLES"; }
                PanelRow {
                    text: "Off";
                    checked: PlayerState.sub-off;
                    focused: spanel.remote && PlayerState.panel-row == PlayerState.off-row;
                    reveal(y, h) => { spanel.reveal(y, h); }
                    clicked => { PlayerState.select-sub(-1); }
                }
                if PlayerState.can-find-subs: PanelRow {
                    text: "Find subtitles online…";
                    focused: spanel.remote && PlayerState.panel-row == PlayerState.find-row;
                    reveal(y, h) => { spanel.reveal(y, h); }
                    clicked => { PlayerState.open-panel("subsearch"); }
                }
                for t[i] in PlayerState.sub-tracks: PanelRow {
                    text: t.label;
                    checked: t.selected;
                    focused: spanel.remote && PlayerState.panel-row == PlayerState.subs-row + i;
                    reveal(y, h) => { spanel.reveal(y, h); }
                    clicked => { PlayerState.select-sub(t.id); }
                }
                PanelHeading { text: "SPEED"; }
                HorizontalLayout {
                    property <bool> here: spanel.remote && PlayerState.panel-row == PlayerState.speed-row;
                    changed here => { if (self.here) { spanel.reveal(self.y - 26px, self.height + 26px); } }
                    spacing: 4px;
                    padding-top: 4px;
                    for sp[i] in PlayerState.speeds: Rectangle {
                        height: 30px;
                        border-radius: 7px;
                        border-width: parent.here && PlayerState.panel-col == i ? 2px : 0px;
                        border-color: white;
                        background: Math.abs(PlayerState.speed - sp) < 0.01 ? Theme.accent : sta.has-hover ? #ffffff1c : #ffffff10;
                        Text {
                            text: sp + "×";
                            color: Math.abs(PlayerState.speed - sp) < 0.01 ? Theme.accent-text : white;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        sta := TouchArea { mouse-cursor: pointer; clicked => { PlayerState.set-speed(sp); } }
                    }
                }
                PanelHeading { text: "SUBTITLE SIZE"; }
                HorizontalLayout {
                    property <bool> here: spanel.remote && PlayerState.panel-row == PlayerState.size-row;
                    changed here => { if (self.here) { spanel.reveal(self.y - 26px, self.height + 26px); } }
                    spacing: 4px;
                    padding-top: 4px;
                    for sz[i] in [{ v: 0.8, t: "S" }, { v: 1.0, t: "M" }, { v: 1.25, t: "L" }, { v: 1.6, t: "XL" }]: Rectangle {
                        height: 30px;
                        border-radius: 7px;
                        border-width: parent.here && PlayerState.panel-col == i ? 2px : 0px;
                        border-color: white;
                        background: Math.abs(PlayerState.sub-scale - sz.v) < 0.01 ? Theme.accent : sza.has-hover ? #ffffff1c : #ffffff10;
                        Text { text: sz.t; color: Math.abs(PlayerState.sub-scale - sz.v) < 0.01 ? Theme.accent-text : white; font-size: 12px; font-weight: 600; }
                        sza := TouchArea { mouse-cursor: pointer; clicked => { PlayerState.set-sub-scale(sz.v); } }
                    }
                }
                PanelHeading { text: "SYNC"; }
                Stepper {
                    label: "Subtitle delay";
                    value: PlayerState.sub-delay;
                    focused-col: spanel.remote && PlayerState.panel-row == PlayerState.sub-delay-row ? PlayerState.panel-col : -1;
                    changed focused-col => { if (self.focused-col >= 0) { spanel.reveal(self.y - 26px, self.height + 26px); } }
                    nudge(d) => { PlayerState.nudge-sub-delay(d); }
                }
                Stepper {
                    label: "Audio delay";
                    value: PlayerState.audio-delay;
                    focused-col: spanel.remote && PlayerState.panel-row == PlayerState.audio-delay-row ? PlayerState.panel-col : -1;
                    changed focused-col => { if (self.focused-col >= 0) { spanel.reveal(self.y, self.height); } }
                    nudge(d) => { PlayerState.nudge-audio-delay(d); }
                }
                PanelHeading { text: "INTROS AND CREDITS"; }
                PanelRow {
                    text: "Skip automatically";
                    checked: PlayerState.auto-skip;
                    focused: spanel.remote && PlayerState.panel-row == PlayerState.auto-skip-row;
                    reveal(y, h) => { spanel.reveal(y - 26px, h + 26px); }
                    clicked => { PlayerState.set-auto-skip(!PlayerState.auto-skip); }
                }
            }
        }
    }

    // Episodes or chapters.
    if PlayerState.panel == "list": lpanel := Rectangle {
        function reveal(y: length, h: length) {
            if (y < -lflick.content-y) {
                lflick.content-y = -y;
            } else if (y + h > -lflick.content-y + lflick.height) {
                lflick.content-y = -(y + h - lflick.height);
            }
        }
        width: Math.min(Theme.tv ? 460px : 360px, root.width - 32px);
        x: root.width - self.width - 16px;
        y: 60px;
        height: root.height - 60px - 132px;
        border-radius: 14px;
        background: #1f1f21f2;
        border-width: 1px;
        border-color: #ffffff1c;
        drop-shadow-blur: PlayerState.window-modes ? 30px : 0px;
        drop-shadow-color: #00000090;
        TouchArea { }
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            PanelHeading { text: PlayerState.list-title; height: 22px; }
            lflick := Flickable {
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    for e[i] in PlayerState.list-items: PanelRow {
                        text: e.title;
                        detail: e.detail;
                        checked: e.current;
                        focused: Theme.tv && PlayerState.panel-row == i;
                        reveal(y, h) => { lpanel.reveal(y, h); }
                        clicked => { PlayerState.pick(e.id); }
                    }
                    if PlayerState.list-items.length == 0: Text { text: "Nothing to show"; color: #ffffff80; font-size: Theme.tv ? 16px : 13px; }
                }
            }
        }
    }

    // Online subtitle search.
    if PlayerState.panel == "subsearch": fpanel := Rectangle {
        function reveal(y: length, h: length) {
            if (y < -fflick.content-y) {
                fflick.content-y = -y;
            } else if (y + h > -fflick.content-y + fflick.height) {
                fflick.content-y = -(y + h - fflick.height);
            }
        }
        width: Math.min(Theme.tv ? 480px : 420px, root.width - 32px);
        x: root.width - self.width - 16px;
        y: 60px;
        height: root.height - 60px - 132px;
        border-radius: 14px;
        background: #1f1f21f2;
        border-width: 1px;
        border-color: #ffffff1c;
        TouchArea { }
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            PanelHeading { text: "FIND SUBTITLES"; height: 22px; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for l[i] in PlayerState.sub-langs: Rectangle {
                    height: 28px;
                    width: lt.preferred-width + 20px;
                    border-radius: 14px;
                    border-width: Theme.tv && PlayerState.panel-row == 0 && PlayerState.panel-col == i ? 2px : 0px;
                    border-color: white;
                    background: l.current ? Theme.accent : lta.has-hover ? #ffffff1c : #ffffff10;
                    lt := Text { text: l.title; color: l.current ? Theme.accent-text : white; font-size: 12px; font-weight: 600; }
                    lta := TouchArea { mouse-cursor: pointer; clicked => { PlayerState.find-subs(l.id); } }
                }
            }
            if PlayerState.sub-search-status != "": Text { text: PlayerState.sub-search-status; color: #ffffff90; font-size: 12px; wrap: word-wrap; }
            fflick := Flickable {
                content-height: found.preferred-height;
                found := VerticalLayout {
                    for e[i] in PlayerState.sub-results: PanelRow {
                        text: e.title;
                        detail: e.detail;
                        checked: e.current;
                        focused: Theme.tv && PlayerState.panel-row == i + 1;
                        reveal(y, h) => { fpanel.reveal(y, h); }
                        clicked => { PlayerState.pick(e.id); }
                    }
                }
            }
        }
    }

    if PlayerState.skip-label != "": Button {
        x: root.width - self.width - 32px;
        y: root.height - 170px;
        text: PlayerState.skip-label;
        primary: true;
        // TV remote: OK skips while the controls are hidden; Up from the timeline reaches it.
        focused: Theme.tv && PlayerState.panel == "" && (!PlayerState.controls-visible || PlayerState.focus-row == 2);
        clicked => { PlayerState.skip-marker(); }
    }
}

// ---------- Window ----------

export component AppWindow inherits Window {
    // ---- TV remote in the player ----
    // Controls hidden: OK pauses (or skips the intro when offered), Left/Right jump, Up/Down show
    // the controls. Controls shown: the timeline (Left/Right jump) and, below it, the buttons.
    // Back hides the controls, then leaves the film. True when the key was used.
    function player-remote(k: string, was-shown: bool) -> bool {
        if (PlayerState.panel != "") { return root.panel-remote(k); }
        let back = k == Key.Escape || k == Key.Back || k == Key.Backspace;
        let ok = k == Key.Return || k == " ";
        if (back) {
            if (was-shown && !PlayerState.paused) {
                PlayerState.controls-visible = false;
            } else {
                PlayerState.stop();
            }
            return true;
        }
        if (!was-shown) {
            if (ok && PlayerState.skip-label != "") {
                PlayerState.skip-marker();
                PlayerState.controls-visible = false;
                return true;
            }
            PlayerState.focus-row = k == Key.DownArrow ? 1 : 0;
            PlayerState.focus-col = 2;
            if (ok) { PlayerState.toggle-pause(); }
            if (k == Key.LeftArrow) { PlayerState.seek-by(-10); }
            if (k == Key.RightArrow) { PlayerState.seek-by(30); }
            return true;
        }
        if (PlayerState.focus-row == 2 && PlayerState.skip-label == "") { PlayerState.focus-row = 0; }
        if (PlayerState.focus-row == 0) {
            if (ok) { PlayerState.toggle-pause(); }
            else if (k == Key.LeftArrow) { PlayerState.seek-by(-10); }
            else if (k == Key.RightArrow) { PlayerState.seek-by(30); }
            else if (k == Key.DownArrow) { PlayerState.focus-row = 1; }
            else if (k == Key.UpArrow && PlayerState.skip-label != "") { PlayerState.focus-row = 2; }
            return true;
        }
        if (PlayerState.focus-row == 2) {
            if (ok) { PlayerState.skip-marker(); PlayerState.focus-row = 0; }
            else if (k == Key.DownArrow) { PlayerState.focus-row = 0; }
            return true;
        }
        if (k == Key.LeftArrow) { PlayerState.focus-col = Math.max(0, PlayerState.focus-col - 1); }
        else if (k == Key.RightArrow) { PlayerState.focus-col = Math.min(6, PlayerState.focus-col + 1); }
        else if (k == Key.UpArrow) { PlayerState.focus-row = 0; }
        else if (ok) { root.player-button(PlayerState.focus-col); }
        return true;
    }

    function player-button(c: int) {
        if (c == 0) { PlayerState.prev(); }
        else if (c == 1) { PlayerState.seek-by(-10); }
        else if (c == 2) { PlayerState.toggle-pause(); }
        else if (c == 3) { PlayerState.seek-by(30); }
        else if (c == 4) { PlayerState.next(); }
        else {
            PlayerState.panel-row = 0;
            PlayerState.panel-col = 0;
            PlayerState.open-panel(c == 5 ? "settings" : "list");
        }
    }

    // How many choices a row of the settings panel has side by side.
    function settings-width(r: int) -> int {
        if (r == PlayerState.speed-row) { return PlayerState.speeds.length; }
        if (r == PlayerState.size-row) { return PlayerState.sizes.length; }
        if (r == PlayerState.sub-delay-row || r == PlayerState.audio-delay-row) { return 2; }
        return 1;
    }

    // The remote inside the open panel: Up/Down move, Left/Right pick within a row, OK chooses,
    // Back closes the panel.
    function panel-remote(k: string) -> bool {
        let ok = k == Key.Return || k == " ";
        let step = k == Key.UpArrow ? -1 : k == Key.DownArrow ? 1 : 0;
        let side = k == Key.LeftArrow ? -1 : k == Key.RightArrow ? 1 : 0;
        if (k == Key.Escape || k == Key.Back || k == Key.Backspace) {
            PlayerState.open-panel("");
            return true;
        }
        let r = PlayerState.panel-row;
        if (PlayerState.panel == "settings") {
            if (step != 0) {
                PlayerState.panel-row = Math.max(0, Math.min(PlayerState.auto-skip-row, r + step));
                PlayerState.panel-col = Math.min(PlayerState.panel-col, root.settings-width(PlayerState.panel-row) - 1);
            } else if (side != 0) {
                PlayerState.panel-col = Math.max(0, Math.min(root.settings-width(r) - 1, PlayerState.panel-col + side));
            } else if (ok) {
                if (r < PlayerState.off-row) { PlayerState.select-audio(PlayerState.audio-tracks[r].id); }
                else if (r == PlayerState.off-row) { PlayerState.select-sub(-1); }
                else if (r == PlayerState.find-row) {
                    PlayerState.panel-row = 0;
                    PlayerState.panel-col = 0;
                    PlayerState.open-panel("subsearch");
                }
                else if (r < PlayerState.speed-row) { PlayerState.select-sub(PlayerState.sub-tracks[r - PlayerState.subs-row].id); }
                else if (r == PlayerState.speed-row) { PlayerState.set-speed(PlayerState.speeds[PlayerState.panel-col]); }
                else if (r == PlayerState.size-row) { PlayerState.set-sub-scale(PlayerState.sizes[PlayerState.panel-col]); }
                else if (r == PlayerState.sub-delay-row) { PlayerState.nudge-sub-delay(PlayerState.panel-col == 0 ? -0.1 : 0.1); }
                else if (r == PlayerState.audio-delay-row) { PlayerState.nudge-audio-delay(PlayerState.panel-col == 0 ? -0.1 : 0.1); }
                else { PlayerState.set-auto-skip(!PlayerState.auto-skip); }
            }
        } else if (PlayerState.panel == "list") {
            if (step != 0) {
                PlayerState.panel-row = Math.max(0, Math.min(PlayerState.list-items.length - 1, r + step));
            } else if (ok && r < PlayerState.list-items.length) {
                PlayerState.pick(PlayerState.list-items[r].id);
            }
        } else if (PlayerState.panel == "subsearch") {
            // Row 0: the languages; then the subtitles found.
            if (step != 0) {
                PlayerState.panel-row = Math.max(0, Math.min(PlayerState.sub-results.length, r + step));
            } else if (side != 0 && r == 0) {
                PlayerState.panel-col = Math.max(0, Math.min(PlayerState.sub-langs.length - 1, PlayerState.panel-col + side));
            } else if (ok && r == 0 && PlayerState.panel-col < PlayerState.sub-langs.length) {
                PlayerState.find-subs(PlayerState.sub-langs[PlayerState.panel-col].id);
            } else if (ok && r > 0 && r <= PlayerState.sub-results.length) {
                PlayerState.pick(PlayerState.sub-results[r - 1].id);
            }
        }
        return true;
    }

    title: "Encheo";
    icon: @image-url("icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    // Transparent so the sidebar can show the window blur behind it, and so mpv's frame (drawn
    // just before the UI) shows through on the player screen. Screens paint their own background.
    background: Theme.buttons-in-content || root.screen == "player" ? transparent : Theme.bg;

    in-out property <string> screen: "signin";

    // Sign-in
    in property <string> pin-code;
    in property <string> signin-status;
    callback open-link();
    callback new-code();
    callback skip-plex();

    // Home
    in property <[LibraryEntry]> libraries;
    in-out property <int> selected-library: -1;
    in property <[Poster]> continue-watching;
    in property <[HomeRow]> home-rows;
    in property <Billboard> billboard;
    callback animations-toggled();
    // Android: HDR and surround passthrough (Settings).
    in property <string> direct-info;
    in property <bool> direct-on;
    callback direct-toggled();
    // Plex Home profiles (profiles.rs): the people, the picker, and the PIN pad.
    // Movie and TV libraries: the bar of sort and filter chips, the A–Z rail, and the panel of
    // choices a chip opens (filter-sheet: the chip's index, -1 closed).
    in property <[FilterChip]> filter-chips;
    in property <[AzLetter]> az;
    // Search: "Did you mean", "Not in your library" and "In your library, like …" rows.
    in property <[HomeRow]> search-rows;
    in property <int> filter-sheet: -1;
    in property <string> filter-sheet-title;
    in property <[string]> filter-sheet-options;
    in property <int> filter-sheet-current;
    in-out property <int> filter-sheet-focus;
    callback filter-chip(int);
    callback filter-pick(int);
    callback filter-sheet-key(string);
    callback filter-sheet-close();
    in property <[ProfileEntry]> profiles;
    in property <bool> can-switch-profile;
    in-out property <bool> profiles-open;
    in-out property <int> profile-focus;
    in property <bool> profile-busy;
    in property <string> profile-error;
    in property <string> pin-name;        // not empty: asking this person's PIN
    in property <int> pin-length;
    in-out property <int> pin-focus;
    callback profile-pick(int);
    callback pin-key(string);
    callback profile-key(string) -> bool;
    callback profiles-back();
    callback switch-profile();
    callback row-more(int);
    callback billboard-play();
    in property <[Poster]> grid;
    in property <string> grid-title;
    in property <bool> grid-square;
    in property <bool> loading;
    in-out property <string> search-text;
    in property <[string]> grid-tabs;
    in property <int> grid-tab;
    in property <[Track]> songs;
    callback select-tab(int);
    callback select-library(int);
    callback open-item(string);
    in-out property <bool> add-source-open;
    in-out property <bool> sources-open;    // the Settings window
    in property <bool> can-tv-mode;         // desktop: Settings offers TV Mode
    callback tv-mode();
    in-out property <int> sources-confirm: -1;
    in property <[SourceRow]> sources;
    // The add/edit form's fields, so an edit can fill them in.
    in-out property <int> form-kind: 1;
    in-out property <string> form-name;
    in-out property <string> form-location;
    in-out property <string> form-user;
    in-out property <string> form-password;
    in property <bool> form-editing;
    in-out property <bool> about-open;
    // About's buttons on a remote: 0 Licences, 1 Close.
    in-out property <int> about-col: 1;
    changed about-open => { if (self.about-open) { self.about-col = 1; } }
    // The open-source licences (notices.txt), in pieces, while they're shown.
    in-out property <bool> notices-open;
    in property <[string]> notices;
    callback open-notices();
    callback notices-closed();
    function notices-key(k: string) {
        if (k == Key.UpArrow || k == Key.PageUp) {
            nlist.content-y = Math.min(0px, nlist.content-y + nlist.visible-height * 0.8);
        } else if (k == Key.DownArrow || k == Key.PageDown || k == " ") {
            nlist.content-y = Math.max(Math.min(0px, nlist.visible-height - nlist.content-height), nlist.content-y - nlist.visible-height * 0.8);
        } else if (k == Key.Escape || k == Key.Back || k == Key.Backspace || k == Key.Return) {
            root.notices-open = false;
            root.notices-closed();
        }
    }
    in property <string> app-version;
    in property <bool> add-source-busy;
    in-out property <string> add-source-status;
    in property <[FoundSource]> found-sources;
    in property <bool> scanning;
    in property <bool> can-speed-test;
    callback speed-test();
    callback add-source(int, string, string, string, string);
    callback scan();
    callback open-sources();
    callback new-source();
    callback edit-source(string, int);
    callback remove-source(string, int);
    callback search(string);
    callback refresh();

    // Detail
    in property <Poster> detail;
    in property <image> detail-backdrop;
    in property <string> detail-meta;
    in property <string> detail-summary;
    in property <string> detail-tech;
    in property <string> play-label;
    in property <bool> detail-is-show;
    in property <[string]> seasons;
    in property <[bool]> seasons-watched;   // every episode of that season seen
    in-out property <int> selected-season;
    in property <[Episode]> episodes;
    in property <string> detail-kind;
    in property <[Poster]> albums;
    in property <[Track]> tracks;
    in property <[string]> detail-badges;
    in property <string> detail-summary-full;
    in property <string> detail-file;
    in property <bool> detail-can-restart;
    in property <bool> detail-can-trailer;
    in property <string> detail-play-icon: "play";
    in property <bool> detail-play-enabled: true;
    in property <float> detail-play-progress: -1;
    in property <string> detail-play-note;
    in property <bool> detail-watchlist-mode;
    in property <bool> detail-watched;
    in property <bool> detail-can-mark-watched;
    in property <bool> detail-can-favourite;
    in property <bool> detail-favourite;
    in property <[Person]> people;
    in property <[Score]> scores;
    in property <[Poster]> related;
    callback play-from-start();
    callback play-trailer();
    callback toggle-watched();
    callback toggle-favourite();
    callback back();
    callback play-detail();
    callback play-track(string);
    callback select-season(int);
    callback play-episode(string);

    // Music (plays under the other screens)
    in property <bool> music-active;
    in property <string> music-title;
    in property <string> music-artist;
    in property <image> music-art;
    in property <bool> music-paused;
    in property <float> music-position;
    in property <float> music-duration;
    in property <string> music-position-text;
    in property <string> music-duration-text;
    callback music-toggle();
    callback music-next();
    callback music-prev();
    callback music-close();
    callback music-seek-to(float);
    in property <int> music-repeat;          // 0 off, 1 all, 2 one
    in property <image> music-art-large;
    in property <[Track]> music-queue;
    in property <int> music-queue-index;
    // Lyrics in Now Playing (see lyrics.rs): open or not, the lines, the one being sung, and
    // "loading", "none", "plain" or "synced".
    in-out property <bool> lyrics-open;
    in property <[LyricLine]> music-lyrics;
    in property <int> music-lyric-index: -1;
    in property <string> music-lyrics-state: "loading";
    in property <string> music-lyrics-credit;
    callback lyrics-toggled();
    in-out property <bool> now-playing-open;
    callback now-playing(bool);
    callback music-jump(string);
    callback music-repeat-cycle();
    in property <bool> detail-can-shuffle;
    callback shuffle-detail();

    in property <string> toast;

    // One keyboard handler for the whole window, so keys work no matter what was clicked last.
    // Taking focus back on every screen change stops a hidden search field from swallowing keys.
    forward-focus: keys;
    init => { keys.focus(); }
    changed screen => { keys.focus(); }
    property <int> refocus: Nav.refocus-request;
    changed refocus => { keys.focus(); }
    keys := FocusScope {
        key-pressed(e) => {
            if (root.profiles-open) { root.profile-key(e.text); return accept; }
            if (root.filter-sheet >= 0) { root.filter-sheet-key(e.text); return accept; }
            if (root.notices-open) { root.notices-key(e.text); return accept; }
            if (e.text == Key.Back && root.screen == "home" && Nav.back()) { return accept; }
            // Back on the music bar leaves the bar, not the page under it.
            if ((e.text == Key.Back || e.text == Key.Backspace) && (Nav.zone == "music" || root.now-playing-open) && Nav.back()) { return accept; }
            if (root.screen == "player") {
                let was-shown = PlayerState.controls-visible;
                PlayerState.poke();
                if (Theme.tv && root.player-remote(e.text, was-shown)) { return accept; }
                if (e.text == " " || e.text == "k" || e.text == Key.Return) { PlayerState.toggle-pause(); return accept; }
                if (e.text == Key.LeftArrow) { PlayerState.seek-by(-10); return accept; }
                if (e.text == Key.RightArrow) { PlayerState.seek-by(30); return accept; }
                if (e.text == Key.UpArrow) { PlayerState.set-volume(Math.min(1, PlayerState.volume + 0.05)); return accept; }
                if (e.text == Key.DownArrow) { PlayerState.set-volume(Math.max(0, PlayerState.volume - 0.05)); return accept; }
                if (e.text == "m") { PlayerState.toggle-mute(); return accept; }
                if (e.text == "f") { PlayerState.toggle-fullscreen(); return accept; }
                if (e.text == "n") { PlayerState.next(); return accept; }
                if (e.text == "p") { PlayerState.prev(); return accept; }
                // Android's Back button arrives as Key.Back and behaves like Escape.
                if ((e.text == Key.Escape || e.text == Key.Back) && PlayerState.panel != "") { PlayerState.open-panel(""); return accept; }
                if (e.text == Key.Escape && PlayerState.fullscreen) { PlayerState.toggle-fullscreen(); return accept; }
                if (e.text == Key.Escape || e.text == Key.Backspace || e.text == Key.Back) { PlayerState.stop(); return accept; }
            } else if (root.screen == "detail") {
                if (e.text == Key.Escape || e.text == Key.Backspace || e.text == Key.Back) { root.back(); return accept; }
                if (Nav.key(e.text)) { return accept; }
                if (root.music-active && e.text == " ") { root.music-toggle(); return accept; }
            } else if (root.screen == "home" && Nav.key(e.text)) {
                return accept;
            } else if (root.music-active && e.text == " ") {
                root.music-toggle();
                return accept;
            }
            reject
        }
    }

    // Phones: keep clear of the status and navigation bars. (macOS reports its titlebar here,
    // which our design already uses on purpose, so only when the window buttons aren't ours.)
    property <length> inset-top: Theme.buttons-in-content ? 0 : root.safe-area-insets.top;
    property <length> inset-bottom: Theme.buttons-in-content ? 0 : root.safe-area-insets.bottom;

    if root.screen == "signin": SignIn {
        y: root.inset-top;
        height: root.height - root.inset-top - root.inset-bottom;
        code: root.pin-code;
        status: root.signin-status;
        open-link => { root.open-link(); }
        retry => { root.new-code(); }
        skip => { root.skip-plex(); }
    }
    if root.screen == "home": Home {
        y: root.inset-top;
        height: root.height - root.inset-top - root.inset-bottom;
        libraries: root.libraries;
        selected: root.selected-library;
        continue-watching: root.continue-watching;
        rows: root.home-rows;
        billboard: root.billboard;
        billboard-play => { root.billboard-play(); }
        row-more(i) => { root.row-more(i); }
        grid: root.grid;
        grid-title: root.grid-title;
        grid-square: root.grid-square;
        tabs: root.grid-tabs;
        tab: root.grid-tab;
        songs: root.songs;
        select-tab(i) => { root.select-tab(i); }
        filters: root.filter-chips;
        az: root.az;
        search-rows: root.search-rows;
        filter-chip(i) => { root.filter-chip(i); }
        loading: root.loading;
        search-text <=> root.search-text;
        bottom-inset: root.music-active ? 96px : 0px;
        select(i) => { root.select-library(i); }
        open(id) => { root.open-item(id); }
        search(q) => { root.search(q); }
        settings => { root.open-sources(); }
        can-speed-test: root.can-speed-test;
        speed-test => { root.speed-test(); }
    }
    if root.screen == "detail": Detail {
        y: root.inset-top;
        height: root.height - root.inset-top - root.inset-bottom;
        item: root.detail;
        backdrop: root.detail-backdrop;
        meta: root.detail-meta;
        summary: root.detail-summary;
        tech: root.detail-tech;
        play-label: root.play-label;
        play-icon: root.detail-play-icon;
        play-enabled: root.detail-play-enabled;
        play-progress: root.detail-play-progress;
        play-note: root.detail-play-note;
        is-show: root.detail-is-show;
        seasons: root.seasons;
        seasons-watched: root.seasons-watched;
        selected-season: root.selected-season;
        episodes: root.episodes;
        kind: root.detail-kind;
        albums: root.albums;
        tracks: root.tracks;
        badges: root.detail-badges;
        summary-full: root.detail-summary-full;
        file-name: root.detail-file;
        can-restart: root.detail-can-restart;
        watched: root.detail-watched;
        can-mark-watched: root.detail-can-mark-watched;
        can-favourite: root.detail-can-favourite;
        favourite: root.detail-favourite;
        people: root.people;
        scores: root.scores;
        related: root.related;
        bottom-inset: root.music-active ? 96px : 0px;
        play-from-start => { root.play-from-start(); }
        can-trailer: root.detail-can-trailer;
        watchlist-mode: root.detail-watchlist-mode;
        play-trailer => { root.play-trailer(); }
        can-shuffle: root.detail-can-shuffle;
        shuffle => { root.shuffle-detail(); }
        toggle-watched => { root.toggle-watched(); }
        toggle-favourite => { root.toggle-favourite(); }
        open(id) => { root.open-item(id); }
        play-track(id) => { root.play-track(id); }
        back => { root.back(); }
        play => { root.play-detail(); }
        select-season(i) => { root.select-season(i); }
        play-episode(id) => { root.play-episode(id); }
    }
    if root.screen == "player": Player {
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
    }

    if root.music-active && root.now-playing-open && root.screen != "player": NowPlaying {
        title: root.music-title;
        artist: root.music-artist;
        art: root.music-art-large;
        paused: root.music-paused;
        position: root.music-position;
        duration: root.music-duration;
        position-text: root.music-position-text;
        duration-text: root.music-duration-text;
        repeat: root.music-repeat;
        queue: root.music-queue;
        current: root.music-queue-index;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        toggle => { root.music-toggle(); }
        next => { root.music-next(); }
        prev => { root.music-prev(); }
        repeat-clicked => { root.music-repeat-cycle(); }
        seek-to(t) => { root.music-seek-to(t); }
        jump(id) => { root.music-jump(id); }
        close => { root.now-playing(false); }
        lyrics-open: root.lyrics-open;
        lyrics: root.music-lyrics;
        lyric-index: root.music-lyric-index;
        lyrics-state: root.music-lyrics-state;
        lyrics-credit: root.music-lyrics-credit;
        lyrics-clicked => { root.lyrics-open = !root.lyrics-open; root.lyrics-toggled(); }
    }
    if root.music-active && !root.now-playing-open && root.screen != "player" && root.screen != "signin": MiniPlayer {
        // Clear of the sidebar on Home (TV: the narrow rail).
        x: root.screen == "home" && root.width >= 720px ? (Theme.tv ? Theme.rail-width : 240px) + 16px : 16px;
        y: root.height - self.height - 12px - root.inset-bottom;
        width: root.width - self.x - 16px;
        title: root.music-title;
        artist: root.music-artist;
        art: root.music-art;
        paused: root.music-paused;
        position: root.music-position;
        duration: root.music-duration;
        position-text: root.music-position-text;
        duration-text: root.music-duration-text;
        toggle => { root.music-toggle(); }
        next => { root.music-next(); }
        prev => { root.music-prev(); }
        close => { root.music-close(); }
        seek-to(t) => { root.music-seek-to(t); }
        repeat: root.music-repeat;
        focus-col: Nav.active && Nav.zone == "music" ? Nav.col : -1;
        repeat-clicked => { root.music-repeat-cycle(); }
        expand => { root.now-playing(true); }
    }

    changed sources-open => { if (!self.sources-open) { Nav.dialog-closed(); } }
    if root.sources-open: SettingsDialog {
        y: root.inset-top;
        height: root.height - root.inset-top - root.inset-bottom;
        sources: root.sources;
        confirm <=> root.sources-confirm;
        focus-row: Nav.active && Nav.zone == "dialog" ? Nav.row : -1;
        focus-col: Nav.col;
        refresh => {
            root.sources-open = false;
            root.refresh();
        }
        about => { root.about-open = true; }
        can-tv-mode: root.can-tv-mode;
        tv-mode => { root.tv-mode(); }
        animations => { root.animations-toggled(); }
        direct-info: root.direct-info;
        direct-on: root.direct-on;
        direct => { root.direct-toggled(); }
        can-switch-profile: root.can-switch-profile;
        switch-profile => { root.switch-profile(); }
        add => { root.new-source(); }
        edit(k, i) => { root.edit-source(k, i); }
        remove(k, i) => { root.remove-source(k, i); }
        sign-in => {
            root.sources-open = false;
            root.new-code();
        }
        close => { root.sources-open = false; }
    }

    if root.add-source-open: AddSourceDialog {
        y: root.inset-top;
        height: root.height - root.inset-top - root.inset-bottom;
        editing: root.form-editing;
        kind <=> root.form-kind;
        name <=> root.form-name;
        location <=> root.form-location;
        user <=> root.form-user;
        password <=> root.form-password;
        busy: root.add-source-busy;
        status: root.add-source-status;
        found: root.found-sources;
        scanning: root.scanning;
        connect(k, n, l, u, p) => { root.add-source(k, n, l, u, p); }
        cancel => { root.add-source-open = false; }
    }

    // A filter chip's choices, in a panel on the right.
    if root.filter-sheet >= 0: Rectangle {
        y: root.inset-top;
        height: root.height - root.inset-top - root.inset-bottom;
        background: #00000080;
        TouchArea { clicked => { root.filter-sheet-close(); } }
        sheet := Rectangle {
            property <length> row-h: Theme.tv ? 58px : 44px;
            property <length> head: Theme.tv ? 96px : 72px;
            width: min(parent.width, Theme.tv ? 480px : 340px);
            x: parent.width - self.width;
            background: Theme.bg;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;
            TouchArea { }
            Text {
                x: Theme.tv ? 32px : 20px;
                y: 0;
                height: sheet.head;
                text: root.filter-sheet-title;
                color: Theme.text;
                font-size: Theme.tv ? 28px : 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
            list := Flickable {
                y: sheet.head;
                height: sheet.height - sheet.head - 12px;
                content-height: root.filter-sheet-options.length * sheet.row-h;
                property <int> at: root.filter-sheet-focus;
                // Keep the remote's row in view.
                changed at => {
                    if (self.at * sheet.row-h < -self.content-y) {
                        self.content-y = -(self.at * sheet.row-h);
                    } else if ((self.at + 1) * sheet.row-h > -self.content-y + self.height) {
                        self.content-y = -((self.at + 1) * sheet.row-h - self.height);
                    }
                }
                init => {
                    // Open on the current choice.
                    self.content-y = max(min(0px, self.height - self.content-height), -(self.at * sheet.row-h - self.height / 2 + sheet.row-h / 2));
                }
                for o[i] in root.filter-sheet-options: Rectangle {
                    y: i * sheet.row-h;
                    x: Theme.tv ? 16px : 8px;
                    width: sheet.width - 2 * self.x;
                    height: sheet.row-h - 4px;
                    border-radius: 10px;
                    property <bool> focused: i == root.filter-sheet-focus && Nav.active;
                    background: self.focused || ota.has-hover ? Theme.fill-hover : transparent;
                    border-width: self.focused ? 3px : 0px;
                    border-color: #ffffff;
                    HorizontalLayout {
                        padding-left: Theme.tv ? 16px : 12px;
                        padding-right: Theme.tv ? 16px : 12px;
                        spacing: 10px;
                        Text {
                            text: o;
                            color: i == root.filter-sheet-current ? Theme.accent : Theme.text;
                            font-size: Theme.tv ? 19px : 15px;
                            font-weight: i == root.filter-sheet-current ? 700 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if i == root.filter-sheet-current: VerticalLayout {
                            alignment: center;
                            Icon { name: "check"; width: Theme.tv ? 22px : 18px; height: self.width; tint: Theme.accent; }
                        }
                    }
                    ota := TouchArea { mouse-cursor: pointer; clicked => { root.filter-pick(i); } }
                }
            }
        }
    }

    // "Who's watching?": over everything, until someone is chosen (Back keeps the one in use).
    if root.profiles-open: picker := Rectangle {
        property <length> tile: Theme.tv ? 150px : (root.width < 500px ? 88px : 120px);
        property <length> gap: Theme.tv ? 36px : 22px;
        property <int> per-row: 5;
        property <int> cols: Math.min(root.profiles.length, self.per-row);
        property <int> rows: Math.ceil(root.profiles.length / self.per-row);
        property <length> cell-h: self.tile + (Theme.tv ? 70px : 56px);
        background: Theme.bg;
        TouchArea { }
        if root.pin-name == "": VerticalLayout {
            alignment: center;
            spacing: Theme.tv ? 40px : 28px;
            Text { text: "Who's watching?"; color: Theme.text; font-size: Theme.tv ? 44px : 30px; font-weight: 700; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: picker.cols * (picker.tile + picker.gap) - picker.gap;
                    height: picker.rows * picker.cell-h;
                    for p[i] in root.profiles: tile := Rectangle {
                        property <bool> focused: root.profile-focus == i && !root.profile-busy;
                        x: Math.mod(i, picker.per-row) * (picker.tile + picker.gap);
                        y: Math.floor(i / picker.per-row) * picker.cell-h;
                        width: picker.tile;
                        height: picker.cell-h;
                        pic := Rectangle {
                            y: 0;
                            width: parent.width;
                            height: parent.width;
                            border-radius: 12px;
                            clip: true;
                            background: Theme.accent.darker(0.3);
                            Text { text: p.initial; color: white; font-size: parent.height * 0.42; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: Art.image(p.art-url, Art.loaded);
                                image-fit: cover;
                            }
                            // The white edge, on top of the picture.
                            Rectangle { border-radius: 12px; border-width: tile.focused || ta.has-hover ? 4px : 0px; border-color: white; }
                        }
                        HorizontalLayout {
                            y: pic.height + 10px;
                            height: Theme.tv ? 28px : 22px;
                            alignment: center;
                            spacing: 6px;
                            if p.locked: VerticalLayout { alignment: center; Icon { name: "lock"; width: 15px; height: 15px; tint: tile.focused ? Theme.text : Theme.secondary; } }
                            Text {
                                text: p.name;
                                color: tile.focused || ta.has-hover ? Theme.text : Theme.secondary;
                                font-size: Theme.tv ? 20px : 15px;
                                font-weight: p.current ? 700 : 400;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        if p.current: Text {
                            y: pic.height + (Theme.tv ? 40px : 34px);
                            width: parent.width;
                            text: "Watching now";
                            color: Theme.accent;
                            font-size: Theme.tv ? 14px : 11px;
                            horizontal-alignment: center;
                        }
                        ta := TouchArea {
                            enabled: !root.profile-busy;
                            clicked => { root.profile-focus = i; root.profile-pick(i); }
                        }
                    }
                }
            }
            Text { text: root.profile-busy ? "Switching…" : root.profile-error; color: root.profile-busy ? Theme.secondary : #ff6b6b; font-size: 15px; horizontal-alignment: center; height: 20px; }
            if !Theme.tv: HorizontalLayout { alignment: center; Button { text: "Cancel"; clicked => { root.profiles-back(); } } }
        }
        if root.pin-name != "": pinbox := VerticalLayout {
            property <length> key: Theme.tv ? 72px : 60px;
            alignment: center;
            spacing: Theme.tv ? 26px : 20px;
            Text { text: "Enter the PIN for " + root.pin-name; color: Theme.text; font-size: Theme.tv ? 34px : 24px; font-weight: 700; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                spacing: 18px;
                for d in 4: Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    border-width: 2px;
                    border-color: Theme.text;
                    background: d < root.pin-length ? Theme.text : transparent;
                }
            }
            Text { text: root.profile-busy ? "Checking…" : root.profile-error; color: root.profile-busy ? Theme.secondary : #ff6b6b; font-size: 15px; horizontal-alignment: center; height: 20px; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 3 * pinbox.key + 2 * 14px;
                    height: 4 * pinbox.key + 3 * 14px;
                    for k[i] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "cancel", "0", "delete"]: Rectangle {
                        property <bool> focused: Theme.tv && root.pin-focus == i;
                        x: Math.mod(i, 3) * (pinbox.key + 14px);
                        y: Math.floor(i / 3) * (pinbox.key + 14px);
                        width: pinbox.key;
                        height: pinbox.key;
                        border-radius: self.height / 2;
                        background: self.focused ? white : (kta.has-hover ? Theme.fill-hover : Theme.fill);
                        Text {
                            text: k == "cancel" ? "Cancel" : (k == "delete" ? "Delete" : k);
                            color: parent.focused ? black : Theme.text;
                            font-size: k.character-count > 1 ? 13px : (Theme.tv ? 28px : 24px);
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        kta := TouchArea { clicked => { root.pin-focus = i; root.pin-key(k); } }
                    }
                }
            }
        }
    }

    if root.about-open: Rectangle {
        background: #000000a0;
        TouchArea { clicked => { root.about-open = false; } }
        Rectangle {
            width: Math.min(420px, root.width - 32px);
            height: about.preferred-height;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            TouchArea { }
            about := VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text { text: "Encheo"; color: Theme.accent; font-size: 28px; font-weight: 800; horizontal-alignment: center; }
                Text { text: "Version " + root.app-version; color: Theme.secondary; font-size: 13px; horizontal-alignment: center; }
                Text {
                    text: "An open-source media player. Mozilla Public License 2.0.\nPlayback by libmpv and FFmpeg.";
                    color: Theme.text; font-size: 13px; horizontal-alignment: center; wrap: word-wrap;
                }
                Text { text: "github.com/KumaVolt/encheo"; color: Theme.tertiary; font-size: 12px; horizontal-alignment: center; }
                Rectangle { height: 8px; }
                AboutSlint { }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Button { text: "Licences"; focused: Nav.active && root.about-col == 0; clicked => { root.open-notices(); } }
                    Button { text: "Close"; focused: Nav.active && root.about-col == 1; clicked => { root.about-open = false; } }
                }
            }
        }
    }

    // The open-source licences, over About. Always there (hidden) so the keys can scroll its list.
    Rectangle {
        visible: root.notices-open;
        background: #000000c0;
        TouchArea { enabled: root.notices-open; }
        Rectangle {
            y: root.inset-top + 24px;
            width: Math.min(900px, root.width - 32px);
            height: root.height - root.inset-top - root.inset-bottom - 48px;
            border-radius: 16px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.separator;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: "Open-source licences"; color: Theme.text; font-size: Theme.tv ? 26px : 20px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if !Theme.tv: IconButton {
                        icon: "close";
                        size: 32px;
                        icon-size: 14px;
                        clicked => {
                            root.notices-open = false;
                            root.notices-closed();
                        }
                    }
                }
                nlist := ListView {
                    for piece in root.notices: VerticalLayout {
                        padding-bottom: 10px;
                        Text { text: piece; color: Theme.secondary; font-size: Theme.tv ? 16px : 12px; wrap: word-wrap; }
                    }
                }
                if Theme.tv: Text { text: "Up and Down scroll · Back closes"; color: Theme.tertiary; font-size: 14px; horizontal-alignment: center; }
            }
        }
    }

    if root.toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 80px;
        width: t.preferred-width + 40px;
        height: 40px;
        border-radius: 20px;
        background: #3a1c1c;
        t := Text { text: root.toast; color: #ffb4a8; font-size: 13px; }
    }
}
